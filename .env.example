# Mailchimp Integration Settings
# --------------------------------
# 1. MAILCHIMP_API_KEY:
#    Your Mailchimp Marketing API key (e.g. <32-char-hex>-<dc>).
#    The server prefix (e.g. "us21") at the end of the key is automatically detected.
MAILCHIMP_API_KEY=

# 2. MAILCHIMP_LIST_ID (Optional):
#    The Audience / List ID to enrol users into (e.g. a1b2c3d4e5).
#    If omitted, the integration will automatically query your Mailchimp account and use your primary audience list.
MAILCHIMP_LIST_ID=

# 3. MAILCHIMP_SERVER_PREFIX (Optional):
#    The datacenter prefix (e.g. "us21"). Only needed if your API key does not contain the trailing "-usXX".
MAILCHIMP_SERVER_PREFIX=

# Keystatic CMS (Cloud storage)
# --------------------------------
# 4. KEYSTATIC_CLOUD_PROJECT_KEY:
#    Required in production. Keystatic uses Cloud storage in all environments so
#    there is no unauthenticated `local` fallback on a public deployment.
#    Create the project at https://keystatic.cloud, link it to the GitHub repo,
#    then set this in the Netlify site environment variables.
#    The matching project slug is set in keystatic.config.ts under `cloud.project`.
KEYSTATIC_CLOUD_PROJECT_KEY=
