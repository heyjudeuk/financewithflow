# Mailchimp Integration Settings
# --------------------------------
# 1. MAILCHIMP_API_KEY:
#    Your Mailchimp Marketing API key. It has the shape:
#      <32-character hex string>-<datacenter>   (the suffix looks like -us8)
#    No sample value is written here on purpose: a realistic-looking dummy key
#    trips GitHub secret scanning and blocks the push.
MAILCHIMP_API_KEY=

# 2. MAILCHIMP_LIST_ID (Optional):
#    The Audience / List ID to enrol users into (e.g. a1b2c3d4e5).
#    If omitted, the integration queries your Mailchimp account and uses the
#    primary audience list.
MAILCHIMP_LIST_ID=

# 3. MAILCHIMP_SERVER_PREFIX (Optional):
#    The datacenter prefix (e.g. "us8"). The prefix is normally parsed from the
#    end of the API key, so set this ONLY if your key has no trailing "-usNN".
MAILCHIMP_SERVER_PREFIX=

# Keystatic CMS (Cloud storage)
# --------------------------------
# Keystatic Cloud needs NO environment variable. The project is identified by
# `cloud.project` in keystatic.config.ts, and contributors authenticate through
# Keystatic Cloud's GitHub OAuth flow at /keystatic.
# Manage the project (and its allowed URLs) at https://keystatic.cloud.
