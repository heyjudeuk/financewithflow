---
// Modernized Sitewide Footer for Finance with Flow
const currentYear = new Date().getFullYear();
---

<footer class="site-footer fwf-site-footer dynamic-footer footer-full-width">
  <!-- Top Royal Blue Band (#3456A7) -->
  <div class="footer-top-band">
    <div class="footer-container footer-main-grid">
      <!-- Left Column: Logo & Newsletter Subscription -->
      <div class="footer-brand-col">
        <a href="/" class="footer-logo-link" aria-label="Finance with Flow - Home">
          <img
            class="footer-logo"
            src="/wp-content/uploads/2023/12/logo-white-1024x279-2.webp"
            srcset="/wp-content/uploads/2023/12/logo-white-1024x279-2.webp 1024w, /wp-content/uploads/2023/12/logo-white-1024x279-2-300x81.webp 300w, /wp-content/uploads/2023/12/logo-white-1024x279-2-768x207.webp 768w"
            sizes="(max-width: 800px) 100vw, 800px"
            width="800"
            height="216"
            alt="Finance with Flow"
            loading="lazy"
            decoding="async"
          />
        </a>

        <p class="footer-newsletter-text">
          Sign up to our newsletter to receive the latest industry insights, and tips and tricks for a smooth-running finance team!
        </p>

        <form
          class="fwf-form footer-newsletter-form"
          method="post"
          name="Newsletter Sign-up footer"
          data-newsletter-form
          aria-label="Newsletter Sign-up footer"
        >
          <input type="hidden" name="post_id" value="220" />
          <input type="hidden" name="form_id" value="909080d" />
          <div class="form-fields-wrap">
            <label for="footer-email-input" class="visually-hidden">Email</label>
            <input
              type="email"
              name="form_fields[email]"
              id="footer-email-input"
              class="footer-email-input"
              placeholder="Email"
              required="required"
              autocomplete="email"
            />
            <button class="footer-submit-btn" type="submit">
              <span class="fwf-btn-content-wrapper">
                <span class="fwf-btn-text">Join</span>
              </span>
            </button>
          </div>
        </form>
      </div>

      <!-- Right Column: Social Links, Contact & Quick Links -->
      <div class="footer-nav-col">
        <!-- Social Media Icons -->
        <div class="footer-social-wrapper" role="list" aria-label="Social Media Links">
          <a
            class="footer-social-link"
            href="http://www.facebook.com/FinancewithFlow"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            role="listitem"
          >
            <svg aria-hidden="true" class="footer-social-svg" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
              <path d="M504 256C504 119 393 8 256 8S8 119 8 256c0 123.78 90.69 226.38 209.25 245V327.69h-63V256h63v-54.64c0-62.15 37-96.48 93.67-96.48 27.14 0 55.52 4.84 55.52 4.84v61h-31.28c-30.8 0-40.41 19.12-40.41 38.73V256h68.78l-11 71.69h-57.78V501C413.31 482.38 504 379.78 504 256z"></path>
            </svg>
          </a>

          <a
            class="footer-social-link"
            href="https://www.instagram.com/FinancewithFlow/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            role="listitem"
          >
            <svg aria-hidden="true" class="footer-social-svg" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg">
              <path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"></path>
            </svg>
          </a>

          <a
            class="footer-social-link"
            href="https://www.linkedin.com/company/74514698"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            role="listitem"
          >
            <svg aria-hidden="true" class="footer-social-svg" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg">
              <path d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z"></path>
            </svg>
          </a>
        </div>

        <!-- Contact Links -->
        <div class="footer-contact-details">
          <p class="footer-contact-item">
            <a href="mailto:undercontrol@financewithflow.com">undercontrol@financewithflow.com</a>
          </p>
          <p class="footer-contact-item">
            <a href="tel:+441206326610">01206 326610</a>
          </p>
        </div>

        <!-- Quick Navigation -->
        <nav class="footer-menu-nav" aria-label="Footer Menu">
          <ul class="footer-menu-list">
            <li class="footer-menu-item"><a href="/contact/">Contact</a></li>
            <li class="footer-menu-item"><a href="/privacy-policy/">Privacy Policy</a></li>
            <li class="footer-menu-item"><a href="/cookie-policy-uk/">Cookie Policy (UK)</a></li>
            <li class="footer-menu-item"><a href="/terms-conditions/">Terms &amp; Conditions</a></li>
          </ul>
        </nav>

        <!-- Managed By Credit -->
        <p class="footer-managed-credit">
          Website managed by <a href="https://echo3.co" target="_blank" rel="noopener noreferrer">echo3.co</a>
        </p>
      </div>
    </div>
  </div>

  <!-- Bottom Mint Teal Band (#31CDB0) -->
  <div class="footer-bottom-band">
    <div class="footer-container footer-bottom-flex">
      <!-- Accreditation & Partner Badges -->
      <div class="footer-badges-wrap">
        <img
          class="footer-badge badge-icaew"
          src="/wp-content/uploads/2023/12/ICAEW-Logo.webp"
          width="346"
          height="183"
          alt="ICAEW chartered accountants logo"
          loading="lazy"
          decoding="async"
        />
        <img
          class="footer-badge badge-ift"
          src="/wp-content/uploads/2023/12/IFT-Associate.webp"
          width="845"
          height="857"
          alt="IFT associate"
          loading="lazy"
          decoding="async"
        />
        <img
          class="footer-badge badge-xero"
          src="/wp-content/uploads/2023/12/xero-bronze-partner-badge-CMYK-1024x591.webp"
          width="800"
          height="462"
          alt="Xero bronze partner"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Legal & Company Notice -->
      <div class="footer-legal-wrap">
        <p class="footer-legal-text">
          &copy; All rights reserved {currentYear} | Finance with Flow | Registered Office: The Old Slaughter House, Stour Street, Manningtree, CO11 1BE | Company No: 12527801
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Root Footer Styles */
  .site-footer {
    display: block !important;
    position: relative;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    box-sizing: border-box !important;
    clear: both;
  }

  /* Centered Inner Container */
  .footer-container {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
    box-sizing: border-box;
  }

  /* -------------------------------------------------------------
     Top Blue Band (#3456A7)
     ------------------------------------------------------------- */
  .footer-top-band {
    background-color: #3456A7;
    padding-top: 50px;
    padding-bottom: 50px;
    box-sizing: border-box;
    width: 100%;
  }

  .footer-main-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
  }

  /* Left Column: Brand & Form */
  .footer-brand-col {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-sizing: border-box;
  }

  .footer-logo-link {
    display: inline-block;
    text-decoration: none;
  }

  .footer-logo {
    width: 260px;
    max-width: 100%;
    height: auto;
    display: block;
  }

  .footer-newsletter-text {
    font-family: 'Quicksand', sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: #FFFFFF;
    margin: 0;
    padding: 0;
    font-weight: 500;
  }

  .footer-newsletter-form {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .form-fields-wrap {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .footer-email-input {
    width: 100%;
    box-sizing: border-box;
    background-color: #ECEFF3;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 11px 16px;
    font-family: 'Quicksand', sans-serif;
    font-size: 15px;
    color: #160F3F;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .footer-email-input:focus {
    border-color: #31CDB0;
    background-color: #FFFFFF;
  }

  .footer-email-input::placeholder {
    color: #757575;
    opacity: 1;
  }

  .footer-submit-btn {
    width: 100%;
    box-sizing: border-box;
    background-color: #31CDB0;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 12px 24px;
    font-family: 'Quicksand', sans-serif;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    text-align: center;
    box-shadow: none !important;
    transform: none !important;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .footer-submit-btn:hover,
  .footer-submit-btn:focus {
    background-color: #26a58e;
    color: #FFFFFF;
    box-shadow: none !important;
    transform: none !important;
  }

  /* Right Column: Navigation & Contact */
  .footer-nav-col {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    gap: 12px;
    box-sizing: border-box;
  }

  .footer-social-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 4px;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: #FFFFFF;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .footer-social-svg {
    width: 32px;
    height: 32px;
    fill: currentColor;
    display: block;
  }

  .footer-social-link:hover,
  .footer-social-link:focus {
    color: #31CDB0;
  }

  .footer-contact-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
  }

  .footer-contact-item {
    margin: 0;
    padding: 0;
  }

  .footer-contact-item a {
    font-family: 'Quicksand', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #FFFFFF;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-contact-item a:hover,
  .footer-contact-item a:focus {
    color: #31CDB0;
  }

  .footer-menu-nav {
    margin: 4px 0;
  }

  .footer-menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .footer-menu-item {
    margin: 0;
    padding: 0;
  }

  .footer-menu-item a {
    display: inline-block;
    padding: 2px 0;
    font-family: 'Quicksand', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #FFFFFF;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-menu-item a:hover,
  .footer-menu-item a:focus {
    color: #31CDB0;
  }

  .footer-managed-credit {
    font-family: 'Quicksand', sans-serif;
    font-size: 13px;
    color: #FFFFFF;
    margin: 6px 0 0 0;
    padding: 0;
    opacity: 0.9;
  }

  .footer-managed-credit a {
    color: #FFFFFF;
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .footer-managed-credit a:hover,
  .footer-managed-credit a:focus {
    color: #31CDB0;
  }

  /* -------------------------------------------------------------
     Bottom Teal Band (#31CDB0)
     ------------------------------------------------------------- */
  .footer-bottom-band {
    background-color: #31CDB0;
    padding-top: 18px;
    padding-bottom: 18px;
    box-sizing: border-box;
    width: 100%;
  }

  .footer-bottom-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .footer-badges-wrap {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .footer-badge {
    height: auto;
    display: block;
    object-fit: contain;
  }

  .badge-icaew {
    width: 105px;
    max-height: 44px;
  }

  .badge-ift {
    width: 48px;
    max-height: 48px;
    border-radius: 4px;
  }

  .badge-xero {
    width: 86px;
    max-height: 46px;
    border-radius: 4px;
  }

  .footer-legal-wrap {
    flex: 1;
    text-align: right;
  }

  .footer-legal-text {
    font-family: 'Quicksand', sans-serif;
    font-size: 13px;
    line-height: 1.5;
    color: #FFFFFF;
    margin: 0;
    padding: 0;
    font-weight: 500;
  }

  /* -------------------------------------------------------------
     Responsive Layout (Tablet & Mobile <= 860px)
     ------------------------------------------------------------- */
  @media (max-width: 860px) {
    .footer-top-band {
      padding-top: 40px;
      padding-bottom: 40px;
    }

    .footer-main-grid {
      flex-direction: column;
      gap: 36px;
    }

    .footer-brand-col {
      max-width: 100%;
    }

    .footer-nav-col {
      align-items: flex-start;
      text-align: left;
    }

    .footer-menu-list {
      align-items: flex-start;
    }

    .footer-bottom-flex {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .footer-legal-wrap {
      text-align: left;
    }
  }
</style>
