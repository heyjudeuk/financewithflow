---
const currentYear = new Date().getFullYear();

const locations = [
  { name: 'Suffolk', href: '/why-choose-finance-with-flow-for-payroll-outsourcing-in-suffolk' },
  { name: 'Essex', href: '/why-choose-finance-with-flow-for-payroll-outsourcing-in-essex' },
  { name: 'Colchester', href: '/why-choose-finance-with-flow-for-payroll-outsourcing-in-colchester' },
  { name: 'Chelmsford', href: '/why-choose-finance-with-flow-for-payroll-outsourcing-in-chelmsford' },
  { name: 'Bury St Edmunds', href: '/why-choose-finance-with-flow-for-payroll-outsourcing-in-bury-st-edmunds' },
  { name: 'Harwich', href: '/why-choose-finance-with-flow-for-payroll-outsourcing-in-harwich-2' },
  { name: 'Freeport East', href: '/why-choose-finance-with-flow-for-payroll-outsourcing-in-freeport-east' },
];
---

<footer class="bg-[#160F3F] text-slate-300 pt-16 pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-700/60">
      
      <!-- Company Column -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="inline-block">
          <img 
            src="/images/branding/logo-white.webp" 
            alt="Finance with Flow" 
            class="h-12 w-auto object-contain brightness-110"
            loading="lazy"
          />
        </a>
        <p class="text-slate-400 text-sm leading-relaxed max-w-sm">
          At Finance with Flow, we specialise in providing comprehensive outsourced finance services tailored to empower businesses, restore clarity, and allow them to thrive.
        </p>
        <div class="pt-2 text-sm text-slate-300 space-y-1">
          <p>📍 The Nook, Colchester Road, Great Bromley, Colchester, Essex, CO7 7TN</p>
          <p>✉️ <a href="mailto:undercontrol@financewithflow.com" class="text-[#31CDB0] hover:underline">undercontrol@financewithflow.com</a></p>
        </div>
        
        <!-- Social links -->
        <div class="flex items-center gap-4 pt-3">
          <a href="https://www.facebook.com/FinancewithFlow" target="_blank" rel="noopener noreferrer" class="p-2 rounded-full bg-slate-800 hover:bg-[#3456A7] text-white transition-colors" aria-label="Facebook">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.667 5H18V0h-3.889C10.667 0 9 1.667 9 4.667V8z"/></svg>
          </a>
          <a href="https://www.instagram.com/FinancewithFlow/" target="_blank" rel="noopener noreferrer" class="p-2 rounded-full bg-slate-800 hover:bg-[#3456A7] text-white transition-colors" aria-label="Instagram">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/74514698" target="_blank" rel="noopener noreferrer" class="p-2 rounded-full bg-slate-800 hover:bg-[#3456A7] text-white transition-colors" aria-label="LinkedIn">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-3">
        <p class="text-white font-semibold text-base tracking-wide">Quick Links</p>
        <ul class="space-y-2 text-sm">
          <li><a href="/about" class="hover:text-[#31CDB0] transition-colors">About Us</a></li>
          <li><a href="/meet-the-team" class="hover:text-[#31CDB0] transition-colors">Meet The Team</a></li>
          <li><a href="/services" class="hover:text-[#31CDB0] transition-colors">Our Services</a></li>
          <li><a href="/packages" class="hover:text-[#31CDB0] transition-colors">Packages & Pricing</a></li>
          <li><a href="/blog" class="hover:text-[#31CDB0] transition-colors">Insights & Blog</a></li>
          <li><a href="/faqs" class="hover:text-[#31CDB0] transition-colors">FAQs</a></li>
          <li><a href="/contact" class="hover:text-[#31CDB0] transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Locations -->
      <div class="space-y-3">
        <p class="text-white font-semibold text-base tracking-wide">Locations</p>
        <ul class="space-y-2 text-sm">
          {locations.map(loc => (
            <li>
              <a href={loc.href} class="hover:text-[#31CDB0] transition-colors">
                Payroll in {loc.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Accreditations & Badges -->
      <div class="space-y-3">
        <p class="text-white font-semibold text-base tracking-wide">Accreditations</p>
        <div class="space-y-3 pt-1">
          <div class="bg-white p-2 rounded-lg inline-block w-full max-w-[170px]">
            <img src="/images/branding/icaew-logo.png" alt="ICAEW Member" class="w-full h-auto object-contain" />
          </div>
          <div class="bg-white p-2 rounded-lg inline-block w-full max-w-[170px]">
            <img src="/images/branding/xero-bronze-partner.jpg" alt="Xero Bronze Partner" class="w-full h-auto object-contain" />
          </div>
          <div class="bg-white p-2 rounded-lg inline-block w-full max-w-[170px]">
            <img src="/images/branding/ift-associate.jpg" alt="IFT Associate" class="w-full h-auto object-contain" />
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>&copy; {currentYear} Finance With Flow. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-4">
        <a href="/privacy-policy" class="hover:underline">Privacy Policy</a>
        <a href="/terms-conditions" class="hover:underline">Terms & Conditions</a>
        <a href="/cookie-policy-uk" class="hover:underline">Cookie Policy</a>
        <a href="/keystatic" class="text-slate-300 hover:text-[#31CDB0] font-semibold border-l border-slate-700 pl-4">
          🔐 Editor Login (Keystatic)
        </a>
      </div>
    </div>
  </div>
</footer>
