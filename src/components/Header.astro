---
const currentPath = Astro.url.pathname;

// Helper to determine if a menu link is currently active
const isItemActive = (href: string) => {
  if (href === "/") {
    return currentPath === "/" || currentPath === "";
  }
  return currentPath === href || currentPath.startsWith(href);
};

const navItems = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about/" },
  { label: "Meet The Team", href: "/meet-the-team/" },
  { label: "Services", href: "/services/" },
  { label: "Packages", href: "/packages/" },
  { label: "Insights", href: "/blog/" },
];
---

<header class="site-header dynamic-header header-full-width">
  <div class="header-container">
    <!-- Brand Logo -->
    <a href="/" class="header-logo" aria-label="Finance with Flow - Home">
      <img
        src="/wp-content/uploads/2023/12/logo-colour-240w.webp"
        srcset="/wp-content/uploads/2023/12/logo-colour-240w.webp 240w, /wp-content/uploads/2023/12/logo-colour-360w.webp 360w, /wp-content/uploads/2023/12/logo-colour-1024x279.webp 1024w"
        sizes="(max-width: 800px) 180px, 240px"
        width="240"
        height="65"
        alt="Finance with Flow"
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navItems.map((item) => {
          const active = isItemActive(item.href);
          return (
            <li class="nav-item">
              <a
                href={item.href}
                class:list={["nav-link", { "is-active": active }]}
                aria-current={active ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Desktop Contact CTA -->
    <div class="header-cta-desktop">
      <a href="/contact/" class="header-contact-btn">Contact</a>
    </div>

    <!-- Mobile Hamburger Toggle Button -->
    <button
      type="button"
      class="mobile-toggle"
      id="mobile-nav-toggle"
      aria-label="Open Navigation Menu"
      aria-expanded="false"
      aria-controls="mobile-nav-drawer"
    >
      <!-- Hamburger Icon -->
      <svg
        class="toggle-icon toggle-icon--burger"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="28"
        height="28"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <!-- Close (X) Icon -->
      <svg
        class="toggle-icon toggle-icon--close"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="28"
        height="28"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Mobile Navigation Drawer -->
    <nav
      id="mobile-nav-drawer"
      class="mobile-drawer"
      aria-label="Mobile Navigation"
      hidden
    >
      <ul class="mobile-nav-list">
        {navItems.map((item) => {
          const active = isItemActive(item.href);
          return (
            <li class="mobile-nav-item">
              <a
                href={item.href}
                class:list={["mobile-nav-link", { "is-active": active }]}
                aria-current={active ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
        <li class="mobile-nav-item">
          <a
            href="/contact/"
            class:list={["mobile-nav-link", { "is-active": isItemActive("/contact/") }]}
            aria-current={isItemActive("/contact/") ? "page" : undefined}
          >
            Contact
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Header Container & Exact Gradient Background */
  .site-header {
    display: block !important;
    position: relative;
    z-index: 100;
    width: 100% !important;
    max-width: 100% !important;
    background-color: transparent !important;
    background-image: linear-gradient(315deg, #3456A7 68%, #FFFFFF 0%) !important;
    border-radius: 0 !important;
    padding: 10px 30px !important;
    box-sizing: border-box !important;
    margin: 0 !important;
  }

  .header-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
  }

  /* Logo */
  .header-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header-logo img {
    width: 240px;
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: flex;
    align-items: center;
    margin-left: auto;
    margin-right: 32px;
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 28px;
  }

  .nav-item {
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-family: 'Quicksand', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #FEF9F3;
    text-decoration: none;
    transition: color 0.2s ease;
    padding: 6px 0;
  }

  .nav-link:hover,
  .nav-link:focus {
    color: #31CDB0;
  }

  .nav-link.is-active {
    color: #31CDB0;
  }

  /* Desktop Contact Button */
  .header-cta-desktop {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .header-contact-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #FEF9F3;
    color: #160F3F;
    font-family: 'Quicksand', sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 50px;
    padding: 13px 30px;
    border: 2px solid transparent;
    cursor: pointer;
    box-shadow: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .header-contact-btn:hover,
  .header-contact-btn:focus {
    background-color: #31CDB0;
    color: #160F3F;
    border-color: #31CDB0;
  }

  /* Mobile Toggle & Drawer - Hidden by default on Desktop */
  .mobile-toggle {
    display: none;
  }

  .mobile-drawer {
    display: none;
  }

  /* -------------------------------------------------------------
     Responsive Breakpoint (Tablet & Mobile <= 1024px)
     ------------------------------------------------------------- */
  @media (max-width: 1024px) {
    .site-header {
      background-image: linear-gradient(300deg, #3456A7 34%, #FFFFFF 0%) !important;
      padding: 10px 15px !important;
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
    }

    .header-logo img {
      width: 180px;
    }

    .desktop-nav,
    .header-cta-desktop {
      display: none;
    }

    /* Mobile Hamburger Toggle */
    .mobile-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: none;
      padding: 8px;
      cursor: pointer;
      color: #FFFFFF;
      z-index: 1001;
    }

    .toggle-icon--burger {
      display: block;
    }

    .toggle-icon--close {
      display: none;
    }

    .mobile-toggle[aria-expanded="true"] .toggle-icon--burger {
      display: none;
    }

    .mobile-toggle[aria-expanded="true"] .toggle-icon--close {
      display: block;
    }

    /* Mobile Drawer */
    .mobile-drawer {
      display: block;
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      right: 0;
      background-color: #3456A7;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
      overflow: hidden;
      z-index: 9999;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    }

    .mobile-drawer.is-open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .mobile-nav-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
    }

    .mobile-nav-item {
      border-bottom: 1px solid rgba(255, 255, 255, 0.18);
      margin: 0;
      padding: 0;
    }

    .mobile-nav-item:last-child {
      border-bottom: none;
    }

    .mobile-nav-link {
      display: block;
      padding: 18px 24px;
      color: #FFFFFF;
      font-family: 'Quicksand', sans-serif;
      font-size: 19px;
      font-weight: 600;
      text-decoration: none;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .mobile-nav-link:hover,
    .mobile-nav-link:focus {
      background-color: rgba(255, 255, 255, 0.1);
    }

    .mobile-nav-link.is-active {
      background-color: #31CDB0;
      color: #160F3F;
    }
  }
</style>

<script>
  function setupHeader() {
    const toggle = document.getElementById("mobile-nav-toggle");
    const drawer = document.getElementById("mobile-nav-drawer");

    if (!toggle || !drawer) return;

    function openMenu() {
      toggle?.setAttribute("aria-expanded", "true");
      toggle?.setAttribute("aria-label", "Close Navigation Menu");
      drawer?.removeAttribute("hidden");
      drawer?.classList.add("is-open");
    }

    function closeMenu() {
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-label", "Open Navigation Menu");
      drawer?.classList.remove("is-open");
      // Delay hidden to allow transition to finish smoothly
      setTimeout(() => {
        if (toggle?.getAttribute("aria-expanded") === "false") {
          drawer?.setAttribute("hidden", "");
        }
      }, 200);
    }

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const isExpanded = toggle.getAttribute("aria-expanded") === "true";
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close when clicking outside
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (!toggle.contains(target) && !drawer.contains(target)) {
        if (toggle.getAttribute("aria-expanded") === "true") {
          closeMenu();
        }
      }
    });

    // Close on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        closeMenu();
        toggle.focus();
      }
    });

    // Close on navigation link click
    drawer.querySelectorAll(".mobile-nav-link").forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });

    // Close if resizing back to desktop view
    window.addEventListener("resize", () => {
      if (window.innerWidth > 1024 && toggle.getAttribute("aria-expanded") === "true") {
        closeMenu();
      }
    });
  }

  // Setup on initial load and on Astro view transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupHeader);
  } else {
    setupHeader();
  }
  document.addEventListener("astro:page-load", setupHeader);
</script>
