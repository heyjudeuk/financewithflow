<script>
  // Enable mobile burger menu toggle functionality
  document.querySelectorAll('.elementor-menu-toggle').forEach(toggle => {
    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      toggle.classList.toggle('elementor-active');
      const container = toggle.closest('.elementor-widget-nav-menu');
      const dropdown = container?.querySelector('.elementor-nav-menu--dropdown');
      if (dropdown) {
        dropdown.classList.toggle('elementor-active');
        if (dropdown.classList.contains('elementor-active')) {
          (dropdown as HTMLElement).style.display = 'block';
        } else {
          (dropdown as HTMLElement).style.display = 'none';
        }
      }
    });
  });
</script>
