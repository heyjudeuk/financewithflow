---
const navItems = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Meet The Team', href: '/meet-the-team' },
  { name: 'Services', href: '/services' },
  { name: 'Packages', href: '/packages' },
  { name: 'Insights', href: '/blog' },
  { name: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-slate-100 shadow-xs transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <img 
          src="/images/branding/logo-colour.webp" 
          alt="Finance with Flow" 
          class="h-12 w-auto object-contain"
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8">
        {navItems.map(item => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a 
              href={item.href} 
              class={`text-sm font-semibold tracking-wide transition-colors duration-200 ${
                isActive 
                  ? 'text-[#3456A7] font-bold border-b-2 border-[#31CDB0] pb-1' 
                  : 'text-[#160F3F] hover:text-[#3456A7]'
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- Action Button -->
      <div class="hidden lg:flex items-center gap-4">
        <a 
          href="/contact" 
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-[#3456A7] hover:bg-[#160F3F] transition-all shadow-sm hover:shadow-md"
        >
          Book Discovery Call
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex lg:hidden items-center">
        <button 
          id="mobile-menu-button"
          type="button" 
          class="p-2 rounded-lg text-slate-700 hover:text-[#3456A7] focus:outline-hidden" 
          aria-label="Toggle Navigation Menu"
        >
          <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-slate-200 px-4 pt-2 pb-6 space-y-2">
    {navItems.map(item => (
      <a 
        href={item.href} 
        class="block px-3 py-2 rounded-md text-base font-medium text-[#160F3F] hover:bg-slate-50 hover:text-[#3456A7]"
      >
        {item.name}
      </a>
    ))}
    <div class="pt-4">
      <a 
        href="/contact" 
        class="block w-full text-center px-5 py-3 rounded-full text-sm font-semibold text-white bg-[#3456A7] hover:bg-[#160F3F]"
      >
        Book Discovery Call
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
