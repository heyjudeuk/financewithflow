---
export interface PackageItem {
  id: string;
  name: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
  animationDelay?: number;
}

interface Props {
  heading?: string;
  packages?: PackageItem[];
  ctaText?: string;
  ctaHref?: string;
}

const defaultPackages: PackageItem[] = [
  {
    id: "sunstone",
    name: "Sunstone",
    description: "For businesses that are reaching the end of being able to manage finance themselves.",
    imageSrc: "/wp-content/uploads/2024/01/Bronze-package-A-1024x683.webp",
    imageAlt: "Sunstone payroll outsourcing package",
    animationDelay: 0,
  },
  {
    id: "carnelian",
    name: "Carnelian",
    description: "The Carnelian Package is the ideal choice for businesses looking to elevate their operations and utilise the insights the numbers can provide.",
    imageSrc: "/wp-content/uploads/2024/01/Silver-package-B-1024x683.webp",
    imageAlt: "Carnelian outsourced bookkeeping package",
    animationDelay: 250,
  },
  {
    id: "agate",
    name: "Agate",
    description: "Our Agate Package is designed for businesses seeking a transformative financial partner. Ideal for businesses aiming to strategically enhance their financial operations.",
    imageSrc: "/wp-content/uploads/2024/01/Gold-Package-C-1024x683.webp",
    imageAlt: "Agate accounting outsourcing package",
    animationDelay: 500,
  },
];

const {
  heading = "Our Packages",
  packages = defaultPackages,
  ctaText = "Explore our packages",
  ctaHref = "/packages/",
} = Astro.props;
---

<section class="packages-section" aria-labelledby="heading-packages">
  <div class="packages-container">
    <!-- Header with Decorative Circle -->
    <div class="packages-header">
      <div class="header-circle">
        <h2 id="heading-packages" class="packages-title">{heading}</h2>
      </div>
    </div>

    <!-- 3 Package Cards Grid -->
    <div class="packages-grid">
      {packages.map((pkg) => (
        <div
          class="package-card"
          data-settings={JSON.stringify({
            animation: "fadeIn",
            ...(pkg.animationDelay ? { animation_delay: pkg.animationDelay } : {})
          })}
        >
          <div class="card-image-wrap">
            <img
              src={pkg.imageSrc}
              alt={pkg.imageAlt}
              width="800"
              height="534"
              loading="lazy"
              decoding="async"
              class="card-image"
            />
          </div>
          <div class="card-content">
            <h3 class="card-title">{pkg.name}</h3>
            <p class="card-description">{pkg.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Centered Call to Action Button -->
    <div class="packages-cta-wrap">
      <a class="packages-cta-btn" href={ctaHref}>
        <span>{ctaText}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .packages-section {
    background-color: #FEF9F3;
    padding: 100px 15px;
    overflow: hidden;
    box-sizing: border-box;
  }

  .packages-container {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* Header with decorative circle */
  .packages-header {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .header-circle {
    background-image: url('/wp-content/uploads/2023/12/circle.webp');
    background-position: center center;
    background-repeat: no-repeat;
    background-size: contain;
    padding: 40px 20px 20px 20px;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .packages-title {
    font-family: 'Angel', sans-serif;
    font-size: 4em;
    font-weight: 400;
    color: #160F3F;
    margin: 18px 0 0 0;
    text-align: center;
    line-height: 1;
  }

  /* Cards Grid */
  .packages-grid {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    gap: 30px;
    margin-top: 50px;
    width: 100%;
    box-sizing: border-box;
  }

  .package-card {
    flex: 1;
    background-color: #FFFFFF;
    border-radius: 24px;
    padding: 15px 15px 35px 15px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .card-image-wrap {
    width: 100%;
    overflow: hidden;
    border-radius: 24px;
  }

  .card-image {
    width: 100%;
    height: 250px;
    object-fit: cover;
    object-position: top center;
    border-radius: 24px;
    display: block;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px 0 0 0;
    flex-grow: 1;
  }

  .card-title {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.5em;
    font-weight: 600;
    color: #160F3F;
    text-align: center;
    margin: 10px 0;
  }

  .card-description {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.2em;
    color: #160F3F;
    text-align: center;
    line-height: 1.4;
    margin: 0;
  }

  /* Centered CTA */
  .packages-cta-wrap {
    display: flex;
    justify-content: center;
    padding-top: 50px;
  }

  .packages-cta-btn {
    display: inline-block;
    background-color: #31CDB0;
    color: #160F3F;
    border: 2px solid #31CDB0;
    border-radius: 50px;
    padding: 15px 30px;
    font-family: 'Quicksand', sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    box-shadow: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .packages-cta-btn:hover,
  .packages-cta-btn:focus {
    background-color: #FFFFFF;
    color: #160F3F;
    border-color: #FFFFFF;
  }

  /* -------------------------------------------------------------
     Responsive Breakpoints
     ------------------------------------------------------------- */
  @media (max-width: 1024px) {
    .packages-grid {
      gap: 20px;
    }
  }

  @media (max-width: 767px) {
    .packages-section {
      padding: 50px 15px;
    }

    .header-circle {
      padding: 0;
    }

    .packages-grid {
      flex-direction: column;
      gap: 24px;
      margin-top: 30px;
    }

    .package-card {
      width: 100%;
    }
  }
</style>
