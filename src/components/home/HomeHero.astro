---
interface Props {
  /** Small eyebrow text displayed above the logo */
  eyebrow?: string;
  /** Primary headline text */
  headline?: string;
  /** Subheadline / supporting paragraph text */
  subheadline?: string;
  /** Call-to-action button label */
  ctaText?: string;
  /** Call-to-action link target */
  ctaHref?: string;
}

const {
  eyebrow = "Welcome to",
  headline = "Helping Construction Companies (£1m–£15m turnover) build stronger cash flow, increase profit and make better financial decisions",
  subheadline = "Not at that stage yet? We also work with smaller construction businesses, subcontractors and sole traders who want to build solid finance foundations",
  ctaText = "Upcoming Event: Construction Connections",
  ctaHref = "#construction-connections",
} = Astro.props;
---

<section class="home-hero" aria-label="Introduction">
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-container">
    <div class="hero-content">
      <h2 class="hero-eyebrow">{eyebrow}</h2>

      <div class="hero-logo-wrap">
        <img
          class="hero-logo"
          src="/wp-content/uploads/2023/12/logo-white-1024x279-2.webp"
          srcset="/wp-content/uploads/2023/12/logo-white-1024x279-2.webp 1024w, /wp-content/uploads/2023/12/logo-white-1024x279-2-300x81.webp 300w, /wp-content/uploads/2023/12/logo-white-1024x279-2-768x207.webp 768w"
          sizes="(max-width: 800px) 100vw, 800px"
          width="800"
          height="216"
          alt="Finance with Flow"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="hero-text-group">
        <h1 class="hero-headline">{headline}</h1>
        <p class="hero-subheadline">{subheadline}</p>
      </div>

      <div class="hero-cta-wrap">
        <a class="hero-cta-btn fwf-hero-event-btn" href={ctaHref}>
          <span class="hero-btn-text">{ctaText}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="hero-btn-arrow fwf-hero-btn-arrow"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 85vh;
    overflow: hidden;
    margin-top: 0;
    margin-bottom: 0;
    background-image: url("/wp-content/uploads/2023/12/Finance-with-Flow-Roz-Johnson4212-1.jpg");
    background-size: cover;
    background-position: center;
    box-sizing: border-box;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(271deg, #657ebb 0%, #160f3f 62%);
    opacity: 0.8;
    pointer-events: none;
    z-index: 1;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 15px;
    box-sizing: border-box;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    box-sizing: border-box;
  }

  .hero-eyebrow {
    font-family: "Quicksand", sans-serif;
    font-size: 1.5em;
    font-weight: 400;
    color: #ffffff;
    margin: 0;
    padding: 0;
    line-height: 1;
  }

  .hero-logo-wrap {
    text-align: start;
    margin: 0;
    padding: 0;
  }

  .hero-logo {
    width: 49%;
    max-width: 100%;
    height: auto;
    display: block;
  }

  .hero-text-group {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 2px 0 6px;
  }

  .hero-headline {
    font-family: "Quicksand", sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    padding: 0;
    line-height: 1.32;
    max-width: 960px;
  }

  .hero-subheadline {
    font-family: "Quicksand", sans-serif;
    font-size: 1.15rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    padding: 0;
    line-height: 1.6;
    max-width: 860px;
  }

  .hero-cta-wrap {
    margin-top: 12px;
    display: flex;
    justify-content: flex-start;
  }

  .hero-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background-color: #31cdb0;
    color: #160f3f;
    border: 2px solid #31cdb0;
    border-radius: 50px;
    padding: 14px 28px;
    font-family: "Quicksand", sans-serif;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    box-shadow: none;
    transform: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .hero-cta-btn:hover,
  .hero-cta-btn:focus {
    background-color: #ffffff;
    color: #160f3f;
    border-color: #ffffff;
    box-shadow: none;
    transform: none;
  }

  .hero-btn-arrow {
    flex-shrink: 0;
  }

  @media (max-width: 1366px) {
    .home-hero {
      padding-left: 20px;
      padding-right: 20px;
    }
  }

  @media (max-width: 767px) {
    .home-hero {
      min-height: 75vh;
      margin-top: 0;
      padding-left: 15px;
      padding-right: 15px;
      background-image: url("/wp-content/uploads/2023/12/Finance-with-Flow-Roz-Johnson4212-1-1024x683.jpg");
      background-position: center center;
    }

    .hero-eyebrow {
      font-size: 1.2em;
    }

    .hero-logo {
      width: 100%;
    }

    .hero-text-group {
      gap: 12px;
      margin: 0;
    }

    .hero-headline {
      font-size: 1.45rem;
      line-height: 1.35;
    }

    .hero-subheadline {
      font-size: 1.05rem;
      line-height: 1.55;
    }

    .hero-cta-wrap {
      margin-top: 4px;
      width: 100%;
    }

    .hero-cta-btn {
      width: 100%;
      justify-content: center;
      text-align: center;
      box-sizing: border-box;
    }
  }
</style>
