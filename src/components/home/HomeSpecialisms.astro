---
interface Props {
  heading?: string;
  p1?: string;
  p2?: string;
  ctaText?: string;
  ctaHref?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  heading = "Industry Specialisms",
  p1 = "Our team has a specialised knowledge within the Construction and Subsea Engineering Industries, allowing us to provide valuable insights and advise on your financial processes, whilst benefiting from a strong understanding of the industry-specific regulations, accounting practices and financial management strategies.",
  p2 = "Finance with Flow’s expertise across these industries means you are in safe hands, so rest assured that you will be provided with knowledgeable and appropriate advice, providing you with the tools to achieve your business goals and ensure you are compliant with the many and varied regulations.",
  ctaText = "Explore our services",
  ctaHref = "/services/",
  imageSrc = "/wp-content/uploads/2025/07/construction-image-10-1024x683.jpg",
  imageAlt = "Construction site engineering and development",
} = Astro.props;
---

<section class="specialisms-section" aria-labelledby="heading-specialisms">
  <div class="specialisms-container">
    <div class="specialisms-grid">
      <!-- Left Column: Copy, Circle Title & CTA -->
      <div class="specialisms-content">
        <div class="specialisms-header-wrap" data-settings='{"animation":"fadeInRight"}'>
          <h2 id="heading-specialisms" class="specialisms-title">{heading}</h2>
        </div>

        <div class="specialisms-body">
          <p>{p1}</p>
          <p>{p2}</p>
        </div>

        <div class="specialisms-cta-wrap">
          <a class="specialisms-cta-btn" href={ctaHref}>
            <span>{ctaText}</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Site Image -->
      <div class="specialisms-visual hidden-mobile">
        <img
          src={imageSrc}
          srcset="/wp-content/uploads/2025/07/construction-image-10-1024x683.jpg 1024w, /wp-content/uploads/2025/07/construction-image-10-300x200.jpg 300w, /wp-content/uploads/2025/07/construction-image-10-768x512.jpg 768w, /wp-content/uploads/2025/07/construction-image-10-1536x1025.jpg 1536w, /wp-content/uploads/2025/07/construction-image-10-2048x1366.jpg 2048w"
          sizes="(max-width: 800px) 100vw, 800px"
          width="800"
          height="534"
          alt={imageAlt}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .specialisms-section {
    background-color: #3456A7;
    padding: 100px 15px;
    overflow: hidden;
    box-sizing: border-box;
  }

  .specialisms-container {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .specialisms-grid {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    width: 100%;
  }

  .specialisms-content {
    width: 60%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding-right: 10%;
    box-sizing: border-box;
  }

  .specialisms-header-wrap {
    background-image: url('/wp-content/uploads/2023/12/circle.png');
    background-repeat: no-repeat;
    background-size: contain;
    padding: 40px 0 20px 20px;
    box-sizing: border-box;
  }

  .specialisms-title {
    font-family: 'Angel', sans-serif;
    font-size: 4em;
    font-weight: 400;
    color: #FFFFFF;
    margin: 0;
    line-height: 1;
    text-align: start;
  }

  .specialisms-body {
    font-size: 1.3em;
    color: #FFFFFF;
    line-height: 1.5;
    margin-top: 15px;
  }

  .specialisms-body p {
    margin-top: 0;
    margin-bottom: 1.5em;
  }

  .specialisms-body p:last-child {
    margin-bottom: 0;
  }

  .specialisms-cta-wrap {
    margin-top: 25px;
  }

  .specialisms-cta-btn {
    display: inline-block;
    background-color: #FFFFFF;
    color: #160F3F;
    border: 2px solid #FFFFFF;
    border-radius: 50px;
    padding: 15px 30px;
    font-family: 'Quicksand', sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    box-shadow: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .specialisms-cta-btn:hover,
  .specialisms-cta-btn:focus {
    background-color: #31CDB0;
    color: #160F3F;
    border-color: #31CDB0;
  }

  .specialisms-visual {
    width: 40%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-shrink: 0;
  }

  .specialisms-visual img {
    width: 100%;
    height: auto;
    border-radius: 24px;
    display: block;
  }

  /* -------------------------------------------------------------
     Responsive Breakpoints
     ------------------------------------------------------------- */
  @media (max-width: 1366px) {
    .specialisms-section {
      padding: 100px 20px 50px 20px;
    }
  }

  @media (max-width: 767px) {
    .specialisms-section {
      padding: 25px 15px 50px 15px;
    }

    .specialisms-grid {
      flex-direction: column;
    }

    .specialisms-content {
      width: 100%;
      padding-right: 0;
    }

    .specialisms-header-wrap {
      padding: 0;
      margin-bottom: 20px;
    }

    .hidden-mobile {
      display: none !important;
    }
  }
</style>
