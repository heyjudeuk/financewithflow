---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  /** Social share image, root-relative or absolute. */
  ogImage?: string;
  /** 'website' for pages, 'article' for blog posts. */
  ogType?: 'website' | 'article';
  /** Set true on thin/utility pages that should stay out of the index. */
  noindex?: boolean;
  /** Extra JSON-LD emitted alongside the sitewide Organization schema. */
  schema?: Record<string, any> | Record<string, any>[];
  /**
   * Pages that already contain their own
   * `<main id="content">` set this false, so we don't nest <main> inside <main>
   * (invalid HTML, and it duplicates id="content").
   */
  wrapMain?: boolean;
}

const {
  title = "Home | Outsourced Finance | Finance with Flow",
  description = "At Finance with Flow we specialise in providing comprehensive outsourced finance services that empower businesses and allow them to thrive.",
  bodyClass = "page-template-default page",
  ogImage = '/wp-content/uploads/2025/07/construction-accountants-1-1024x683.webp',
  ogType = 'website',
  noindex = false,
  schema,
  wrapMain = true,
} = Astro.props;

const SITE_URL = Astro.site ?? new URL('https://financewithflow.com');
const canonicalURL = new URL(Astro.url.pathname, SITE_URL);
const ogImageURL = new URL(ogImage, SITE_URL);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  '@id': new URL('/#organization', SITE_URL).href,
  name: 'Finance with Flow',
  url: SITE_URL.href,
  logo: new URL('/wp-content/uploads/2023/12/logo-colour-1024x279.webp', SITE_URL).href,
  image: ogImageURL.href,
  description:
    'Outsourced finance department services for construction and SME businesses across Essex, Suffolk and the East of England.',
  email: 'undercontrol@financewithflow.com',
  telephone: '+441206326610',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'The Old Slaughter House, Stour Street',
    addressLocality: 'Manningtree',
    postalCode: 'CO11 1BE',
    addressCountry: 'GB',
  },
  sameAs: [
    'https://www.facebook.com/FinancewithFlow',
    'https://www.instagram.com/FinancewithFlow/',
    'https://www.linkedin.com/company/74514698',
  ],
};

const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/wp-content/uploads/2023/12/cropped-cropped-logo-colour-32x32.webp" sizes="32x32" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Finance with Flow" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
    {extraSchemas.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}

    <!-- Preload custom script font and decorative assets -->
    <link rel="preload" href="/wp-content/uploads/2023/12/Angel-Heart-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/wp-content/uploads/2023/12/Voga-Medium-2.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/wp-content/uploads/2023/12/circle.webp" as="image" />

    <!-- Google Fonts used by site -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Quicksand:wght@300;400;500;600;700&family=Roboto:wght@300;400;500;700&family=Roboto+Slab:wght@400;700&display=swap" rel="stylesheet" />

    <style is:global>
      @font-face {
        font-family: 'Angel';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/wp-content/uploads/2023/12/Angel-Heart-Regular.ttf') format('truetype');
      }
      @font-face {
        font-family: 'Voga';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/wp-content/uploads/2023/12/Voga-Medium-2.woff') format('woff');
      }

      :root {
        /* Native Design Tokens */
        --color-primary: #3456A7;
        --color-secondary: #160F3F;
        --color-navy: #160F3F;
        --color-cream: #FEF9F3;
        --color-teal: #31CDB0;
        --color-accent: #31CDB0;
        --color-text: #160F3F;
        --color-white: #FFFFFF;

        /* Backward Compatibility Aliases */
        --e-global-color-primary: var(--color-primary);
        --e-global-color-secondary: var(--color-secondary);
        --e-global-color-8b1134b: var(--color-cream);
        --e-global-color-accent: var(--color-teal);
        --e-global-color-text: var(--color-text);
        --e-global-color-af7a151: var(--color-white);
      }

      html {
        scroll-behavior: smooth;
      }

      html, body {
        margin: 0;
        padding: 0;
        font-family: "Quicksand", sans-serif;
        font-weight: 500;
        font-size: 16px;
        line-height: 1.5;
        color: #333333;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* Global Headings default to Quicksand */
      h1, h2, h3, h4, h5, h6 {
        font-family: "Quicksand", sans-serif;
        color: #160F3F;
      }

      p {
        font-family: "Quicksand", sans-serif;
      }

      /* Keyframe Scroll Animations */
      @keyframes fadeIn {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      .fadeIn {
        animation-name: fadeIn;
      }

      @keyframes fadeInLeft {
        from {
          opacity: 0;
          transform: translate3d(-60px, 0, 0);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      .fadeInLeft {
        animation-name: fadeInLeft;
      }

      @keyframes fadeInRight {
        from {
          opacity: 0;
          transform: translate3d(60px, 0, 0);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      .fadeInRight {
        animation-name: fadeInRight;
      }

      @keyframes fadeInDown {
        from {
          opacity: 0;
          transform: translate3d(0, -60px, 0);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      .fadeInDown {
        animation-name: fadeInDown;
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translate3d(0, 60px, 0);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      .fadeInUp {
        animation-name: fadeInUp;
      }

      .animated {
        animation-duration: 1.1s;
        animation-fill-mode: both;
      }

      /* Never hide elements if JS is slow or reduced motion */
      @media (prefers-reduced-motion: reduce) {
        .animated {
          animation: none !important;
          opacity: 1 !important;
          transform: none !important;
        }
      }

      /* Keyboard skip link: hidden until focused, so the visual design is unchanged. */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100000;
        padding: 12px 20px;
        background: #160F3F;
        color: #fff;
        font-family: 'Quicksand', sans-serif;
        font-weight: 600;
        text-decoration: none;
        border-radius: 0 0 6px 0;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>

    <!-- Google Consent Mode v2 (Default: Denied until user consents) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      (function() {
        var stored = null;
        try {
          stored = JSON.parse(localStorage.getItem('fwf_cookie_consent') || 'null');
        } catch(e) {}

        var analytics = stored && stored.analytics === true;
        var marketing = stored && stored.marketing === true;

        gtag('consent', 'default', {
          'analytics_storage': analytics ? 'granted' : 'denied',
          'ad_storage': marketing ? 'granted' : 'denied',
          'ad_user_data': marketing ? 'granted' : 'denied',
          'ad_personalization': marketing ? 'granted' : 'denied',
          'wait_for_update': 500
        });
      })();
    </script>
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          gtag('js', new Date());
          gtag('config', gaId, {
            anonymize_ip: true
          });
        </script>
      </>
    )}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    {wrapMain ? (
      <main id="content" class="site-main">
        <slot />
      </main>
    ) : (
      <slot />
    )}
    <Footer />

    <!-- Scroll Animation Initialization Script -->
    <script>
      function initScrollAnimations() {
        const animatedElements = document.querySelectorAll('[data-settings*="animation"]');
        if (!animatedElements.length) return;

        if (!('IntersectionObserver' in window)) {
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              const settingsAttr = el.getAttribute('data-settings');
              if (settingsAttr) {
                try {
                  const s = JSON.parse(settingsAttr);
                  const anim = s._animation || s.animation || '';
                  const delay = s._animation_delay || s.animation_delay || 0;
                  if (anim && anim !== 'none') {
                    if (delay) el.style.animationDelay = `${delay}ms`;
                    el.classList.add('animated', anim);
                  }
                } catch(e) {}
              }
              observer.unobserve(el);
            }
          });
        }, {
          rootMargin: '0px 0px -30px 0px',
          threshold: 0.05
        });

        animatedElements.forEach(el => observer.observe(el));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollAnimations);
      } else {
        initScrollAnimations();
      }
    </script>
    <script src="../scripts/newsletter.ts"></script>
    <CookieBanner />
    <style is:global>
      /* Sitewide: Ensure no drop shadows on buttons, and no lift hover interactions. Colour change only. */
      button,
      input[type="button"],
      input[type="submit"],
      .fwf-event-cta,
      .fwf-compact-cta,
      .fwf-cookie-btn,
      .fwf-cookie-trigger,
      .fwf-btn,
      .fwf-btn-primary,
      .fwf-btn-outline,
      .cat-pill,
      .page-numbers {
        box-shadow: none !important;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease !important;
      }

      button:hover,
      button:active,
      button:focus,
      input[type="button"]:hover,
      input[type="submit"]:hover,
      .fwf-event-cta:hover,
      .fwf-compact-cta:hover,
      .fwf-cookie-btn:hover,
      .fwf-cookie-trigger:hover,
      .fwf-btn:hover,
      .fwf-btn-primary:hover,
      .fwf-btn-outline:hover,
      .cat-pill:hover,
      .page-numbers:hover {
        transform: none !important;
        box-shadow: none !important;
      }

      /* Full Viewport Width Guarantee */
      header.site-header,
      .site-header,
      .site-header.dynamic-header,
      .site-header.header-full-width {
        width: 100% !important;
        max-width: 100% !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        border-radius: 0 !important;
        box-sizing: border-box !important;
      }

      .site-main {
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
      }
    </style>
  </body>
</html>
