---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  publishedDate: string | Date;
  author?: string;
  featuredImage?: string;
  excerpt?: string;
}

const { title, publishedDate, author = 'Roz Johnson', featuredImage, excerpt } = Astro.props;

const dateStr = typeof publishedDate === 'string' 
  ? new Date(publishedDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : publishedDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout 
  title={`${title} | Finance with Flow`} 
  description={excerpt}
  bodyClass="post-template-default single single-post elementor-default elementor-kit-7 elementor-page"
>
  <div data-elementor-type="single-post" data-elementor-id="1191" class="elementor elementor-1191 elementor-location-single">
    
    <!-- Top Hero Section -->
    <div class="elementor-element e-flex e-con-boxed e-con e-parent" data-settings='{"background_background":"classic"}' style="background: #160F3F; padding: 60px 0 40px 0; color: #ffffff;">
      <div class="e-con-inner" style="max-width: 900px; margin: 0 auto; padding: 0 20px;">
        
        <!-- Post Info Meta -->
        <div class="elementor-element elementor-widget elementor-widget-post-info" style="margin-bottom: 16px;">
          <div class="elementor-widget-container" style="color: #31CDB0; font-size: 14px; font-weight: 600;">
            <span>✍️ {author}</span>
            <span style="margin: 0 8px; color: rgba(255,255,255,0.4);">•</span>
            <span>📅 {dateStr}</span>
            <span style="margin: 0 8px; color: rgba(255,255,255,0.4);">•</span>
            <a href="/blog" style="color: #31CDB0; text-decoration: underline;">Insights & Blog</a>
          </div>
        </div>

        <!-- Post Title -->
        <div class="elementor-element elementor-widget elementor-widget-heading" style="margin-bottom: 24px;">
          <div class="elementor-widget-container">
            <h1 class="elementor-heading-title" style="color: #ffffff; font-size: 38px; line-height: 1.25; font-weight: 700; margin: 0;">
              {title}
            </h1>
          </div>
        </div>

        <!-- Featured Image -->
        {featuredImage && (
          <div class="elementor-element elementor-widget elementor-widget-image" style="margin-top: 30px; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.3);">
            <div class="elementor-widget-container">
              <img 
                src={featuredImage} 
                alt={title} 
                style="width: 100%; height: auto; max-height: 520px; object-fit: cover; display: block;" 
                loading="eager"
              />
            </div>
          </div>
        )}

      </div>
    </div>

    <!-- Excerpt Section -->
    {excerpt && (
      <div class="elementor-element e-flex e-con-boxed e-con e-parent" style="background: #FEF9F3; padding: 30px 0; border-bottom: 1px solid #e2e8f0;">
        <div class="e-con-inner" style="max-width: 800px; margin: 0 auto; padding: 0 20px;">
          <div class="elementor-element elementor-widget elementor-widget-theme-post-excerpt">
            <div class="elementor-widget-container" style="font-size: 18px; font-style: italic; color: #160F3F; line-height: 1.6; font-weight: 500;">
              "{excerpt}"
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Content Section -->
    <div class="elementor-element e-flex e-con-boxed e-con e-parent" style="background: #ffffff; padding: 60px 0;">
      <div class="e-con-inner" style="max-width: 800px; margin: 0 auto; padding: 0 20px;">
        <div class="elementor-element elementor-widget elementor-widget-theme-post-content">
          <div class="elementor-widget-container prose" style="font-size: 16px; line-height: 1.8; color: #2d3748;">
            <slot />
          </div>
        </div>

        <!-- Navigation back to all articles -->
        <div style="margin-top: 50px; padding-top: 30px; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
          <a href="/blog" style="color: #3456A7; font-weight: 700; text-decoration: none; font-size: 15px;">
            ← Back to all Insights
          </a>
          <a href="/contact" style="background: #3456A7; color: #ffffff; padding: 10px 22px; border-radius: 9999px; text-decoration: none; font-size: 14px; font-weight: 600;">
            Book Discovery Call
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom CTA Container: Join the Finance with Flow Journey -->
    <div class="elementor-element elementor-element-a192b6a e-flex e-con-boxed e-con e-parent" data-id="a192b6a" data-element_type="container" style="background: #160F3F; padding: 60px 0; color: #ffffff; text-align: center;">
      <div class="e-con-inner" style="max-width: 700px; margin: 0 auto; padding: 0 20px;">
        <h2 style="font-size: 32px; font-weight: 700; color: #ffffff; margin-bottom: 16px;">
          Join the Finance with Flow Journey
        </h2>
        <p style="font-size: 16px; color: #cbd5e0; line-height: 1.6; margin-bottom: 28px;">
          Let’s work together to not only achieve financial goals but to exceed them while staying true to the heart and soul of your business.
        </p>
        <a href="/contact" style="display: inline-block; background: #31CDB0; color: #160F3F; font-weight: 700; font-size: 15px; padding: 14px 32px; border-radius: 9999px; text-decoration: none;">
          Contact Us Today
        </a>
      </div>
    </div>

  </div>
</BaseLayout>
