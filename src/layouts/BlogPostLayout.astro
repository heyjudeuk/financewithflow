---
import BaseLayout from './BaseLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  category: string;
  publishedDate: string | Date;
  featuredImage?: string;
  excerpt?: string;
  metaDescription?: string;
  canonicalUrl?: string;
  slug?: string;
  author?: string;
  prevPost?: any;
  nextPost?: any;
  relatedPosts?: any[];
}

const {
  title,
  category,
  publishedDate,
  featuredImage,
  excerpt,
  metaDescription,
  canonicalUrl = `https://financewithflow.com/blog/${Astro.props.slug || ''}/`,
  slug,
  prevPost: passedPrev,
  nextPost: passedNext,
  relatedPosts: passedRelated,
} = Astro.props;

const dateObj = new Date(publishedDate);
const dateStr = dateObj.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
});
const isoDate = dateObj.toISOString();

// Helper for category display
function getCategoryDisplayName(cat: string) {
  if (!cat) return 'Uncategorized';
  const c = cat.toLowerCase();
  if (c === 'blogs-from-the-md' || c === 'blogs from the md') return 'Blogs from the MD';
  if (c === 'case-studies' || c === 'case studies') return 'Case Studies';
  if (c === 'news') return 'News';
  if (c === 'outsourcing') return 'Outsourcing';
  if (c === 'social-mobility' || c === 'social mobility') return 'Social Mobility';
  return cat.charAt(0).toUpperCase() + cat.slice(1);
}

// Fetch posts collection as fallback if not passed directly
const allPosts = await getCollection('posts');
const sortedPosts = allPosts
  .filter(p => p.data.status === 'published')
  .sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());

const currentIndex = slug ? sortedPosts.findIndex(p => p.id === slug) : -1;
const prevPost = passedPrev !== undefined ? passedPrev : (currentIndex > 0 ? sortedPosts[currentIndex - 1] : null);
const nextPost = passedNext !== undefined ? passedNext : (currentIndex >= 0 && currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null);

let relatedPosts = passedRelated;
if (!relatedPosts || relatedPosts.length === 0) {
  const otherPosts = sortedPosts.filter(p => p.id !== slug);
  const sameCat = otherPosts.filter(p => p.data.category === category);
  const diffCat = otherPosts.filter(p => p.data.category !== category);
  relatedPosts = [...sameCat, ...diffCat].slice(0, 3);
}


// JSON-LD Schemas
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: metaDescription,
  ...(featuredImage ? { image: new URL(featuredImage, 'https://financewithflow.com').toString() } : {}),
  datePublished: isoDate,
  dateModified: isoDate,
  author: {
    '@type': 'Person',
    name: 'Roz Johnson',
    jobTitle: 'Managing Director',
    worksFor: {
      '@type': 'Organization',
      name: 'Finance with Flow',
    },
  },
  publisher: {
    '@type': 'Organization',
    name: 'Finance with Flow',
    logo: {
      '@type': 'ImageObject',
      url: 'https://financewithflow.com/wp-content/uploads/2023/12/logo-white-1024x279-2.webp',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://financewithflow.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://financewithflow.com/blog/' },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
  ],
};
---

<BaseLayout 
  title={`${title} - Finance With Flow`} 
  description={metaDescription}
  ogType="article"
  {...(featuredImage ? { ogImage: featuredImage } : {})}
  schema={[articleSchema, breadcrumbSchema]}
>
  <div class="blog-single-page">
    
    <!-- CONTAINER 1: Hero Header (Category, Date, Title, Featured Image) -->
    <header class="post-hero">
      <div class="post-hero-container">
        <!-- Left Column: Category, Date, Title -->
        <div class="post-hero-text">
          <div class="post-hero-category">{getCategoryDisplayName(category)}</div>
          <time class="post-hero-date" datetime={isoDate}>{dateStr}</time>
          <h1 class="post-hero-title">{title}</h1>
        </div>

        <!-- Right Column: Featured Image -->
        {featuredImage && (
          <div class="post-hero-media">
            <ResponsiveImage 
              class="post-featured-img" 
              src={featuredImage} 
              alt={title} 
              width={800} 
              height={534} 
              loading="eager" 
              fetchpriority="high"
              decoding="async" 
              sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 800px"
            />
          </div>
        )}
      </div>
    </header>

    <!-- CONTAINER 2: Royal Blue Excerpt Banner -->
    {excerpt && (
      <aside class="post-excerpt-banner">
        <div class="post-narrow-container">
          <p class="post-excerpt-text">{excerpt}</p>
        </div>
      </aside>
    )}

    <!-- CONTAINER 3: Post Content + Share Buttons + Prev/Next Navigation -->
    <div class="post-body-section">
      <div class="post-narrow-container">
        <!-- Post Body (Slotted Markdown Content) -->
        <article class="post-article-body">
          <slot />
        </article>

        <!-- Share Section -->
        <div class="post-share-section">
          <span class="post-share-label">Share the Post:</span>
          <div class="post-share-buttons" role="list">
            <a class="post-share-btn share-facebook" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on facebook" role="listitem">
              <svg aria-hidden="true" class="share-icon" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="M504 256C504 119 393 8 256 8S8 119 8 256c0 123.78 90.69 226.38 209.25 245V327.69h-63V256h63v-54.64c0-62.15 37-96.48 93.67-96.48 27.14 0 55.52 4.84 55.52 4.84v61h-31.28c-30.8 0-40.41 19.12-40.41 38.73V256h68.78l-11 71.69h-57.78V501C413.31 482.38 504 379.78 504 256z"></path></svg>
            </a>
            <a class="post-share-btn share-twitter" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on twitter" role="listitem">
              <svg aria-hidden="true" class="share-icon" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="M459.37 151.716c.325 4.548.325 9.097.325 13.645 0 138.72-105.583 298.558-298.558 298.558-59.452 0-114.68-17.219-161.137-47.106 8.447.974 16.568 1.299 25.34 1.299 49.055 0 94.213-16.568 130.274-44.832-46.132-.975-84.792-31.188-98.112-72.772 6.498.974 12.995 1.624 19.818 1.624 9.421 0 18.843-1.3 27.614-3.573-48.081-9.747-84.143-51.98-84.143-102.985v-1.299c13.969 7.797 30.214 12.67 47.431 13.319-28.264-18.843-46.781-51.005-46.781-87.391 0-19.492 5.197-37.36 14.294-52.954 51.655 63.675 129.3 105.258 216.365 109.807-1.624-7.797-2.599-15.918-2.599-24.04 0-57.828 46.782-104.934 104.934-104.934 30.213 0 57.502 12.67 76.67 33.137 23.715-4.548 46.456-13.32 66.599-25.34-7.798 24.366-24.366 44.833-46.132 57.827 21.117-2.273 41.584-8.122 60.426-16.243-14.292 20.791-32.161 39.308-52.628 54.253z"></path></svg>
            </a>
            <a class="post-share-btn share-linkedin" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on linkedin" role="listitem">
              <svg aria-hidden="true" class="share-icon" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg"><path d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z"></path></svg>
            </a>
          </div>
        </div>

        <!-- Post Navigation (Previous / Next) -->
        <nav class="post-pagination" aria-label="Post Navigation">
          {prevPost ? (
            <div class="post-nav-col post-nav-prev">
              <a href={`/blog/${prevPost.id}/`} rel="prev" class="post-nav-link">
                <span class="post-nav-arrow" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 256 512" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M31.7 239l136-136c9.4-9.4 24.6-9.4 33.9 0l22.6 22.6c9.4 9.4 9.4 24.6 0 33.9L127.9 256l96.4 96.4c9.4 9.4 9.4 24.6 0 33.9L201.7 409c-9.4 9.4-24.6 9.4-33.9 0l-136-136c-9.5-9.4-9.5-24.6-.1-34z"></path></svg>
                </span>
                <span class="post-nav-meta">
                  <span class="post-nav-label">Previous</span>
                  <span class="post-nav-title">{prevPost.data.title}</span>
                </span>
              </a>
            </div>
          ) : (
            <div class="post-nav-col post-nav-prev"></div>
          )}
          {nextPost ? (
            <div class="post-nav-col post-nav-next">
              <a href={`/blog/${nextPost.id}/`} rel="next" class="post-nav-link">
                <span class="post-nav-meta">
                  <span class="post-nav-label">Next</span>
                  <span class="post-nav-title">{nextPost.data.title}</span>
                </span>
                <span class="post-nav-arrow" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 256 512" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M224.3 273l-136 136c-9.4 9.4-24.6 9.4-33.9 0l-22.6-22.6c-9.4-9.4-9.4-24.6 0-33.9l96.4-96.4-96.4-96.4c-9.4-9.4-9.4-24.6 0-33.9L54.3 103c9.4-9.4 24.6-9.4 33.9 0l136 136c9.5 9.4 9.5 24.6.1 34z"></path></svg>
                </span>
              </a>
            </div>
          ) : (
            <div class="post-nav-col post-nav-next"></div>
          )}
        </nav>

      </div>
    </div>

    <!-- CONTAINER 4: Related Posts Section -->
    {relatedPosts && relatedPosts.length > 0 && (
      <section class="post-related-section">
        <div class="post-related-container">
          <h2 class="post-related-heading">Related Posts</h2>
          <div class="post-related-grid" role="list">
            {relatedPosts.map(rPost => {
              const rD = new Date(rPost.data.publishedDate);
              const rDateStr = rD.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
              const rImgUrl = rPost.data.featuredImage || "/wp-content/uploads/2023/12/what-we-do.webp";
              const rCat = getCategoryDisplayName(rPost.data.category);
              const rUrl = `/blog/${rPost.id}/`;

              return (
                <article class="post-related-card" role="listitem">
                  <a class="post-card-thumb-link" href={rUrl} tabindex="-1">
                    <div class="post-card-thumb-wrap">
                      <ResponsiveImage 
                        src={rImgUrl} 
                        alt={rPost.data.title} 
                        loading="lazy" 
                        decoding="async" 
                        width={380} 
                        height={240} 
                        class="post-card-thumb-img"
                        sizes="(max-width: 767px) 100vw, (max-width: 1024px) 50vw, 380px"
                      />
                    </div>
                  </a>
                  <div class="post-card-badge">{rCat}</div>
                  <div class="post-card-body">
                    <h3 class="post-card-title">
                      <a href={rUrl}>{rPost.data.title}</a>
                    </h3>
                    <a class="post-card-read-more" href={rUrl} aria-label={`Read more about ${rPost.data.title}`}>
                      Read More »
                    </a>
                  </div>
                  <div class="post-card-meta">
                    <span class="post-card-date">{rDateStr}</span>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- CONTAINER 5: Join the Finance with Flow Journey CTA -->
    <section class="post-cta-section">
      <div class="post-cta-container">
        <div class="post-cta-card">
          <div class="post-cta-heading-wrap">
            <h2 class="post-cta-heading">Join the Finance with Flow Journey</h2>
          </div>
          <div class="post-cta-body">
            <p>Let’s work together to not only achieve financial goals but to exceed them while staying true to the heart and soul of your business.</p>
            <p>We’re here to help – contact us to today, to discuss your requirements and let’s shape your success together.</p>
          </div>
          <div class="post-cta-btn-wrap">
            <a class="post-cta-btn" href="/contact/">
              Contact us today
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style is:global>
  /* ==========================================================================
     Single Post Layout Styles (Clean Semantic Tokens)
     ========================================================================== */

  .blog-single-page {
    width: 100%;
    overflow-x: hidden;
  }

  /* --------------------------------------------------------------------------
     Container 1: Hero Header
     -------------------------------------------------------------------------- */
  .post-hero {
    background-color: var(--color-cream, #FEF9F3);
    padding: 6% 4%;
    width: 100%;
    box-sizing: border-box;
  }

  .post-hero-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    max-width: 1140px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .post-hero-text {
    flex: 1 1 50%;
    width: 50%;
    max-width: 50%;
  }

  .post-hero-media {
    flex: 1 1 50%;
    width: 50%;
    max-width: 50%;
  }

  .post-hero-category {
    font-family: "Poppins", sans-serif;
    font-size: 16px;
    font-weight: 300;
    line-height: 24px;
    letter-spacing: 10px;
    text-transform: uppercase;
    color: #324A6D;
    margin-bottom: 8px;
  }

  .post-hero-date {
    font-family: "Poppins", sans-serif;
    font-size: 16px;
    font-weight: 300;
    line-height: 24px;
    color: #324A6D;
    margin-bottom: 12px;
    display: block;
  }

  .post-hero-title {
    font-family: "Voga", sans-serif;
    font-size: 64px;
    font-weight: 500;
    line-height: 1em;
    color: #160F3F;
    letter-spacing: normal;
    margin: 0;
  }

  .post-featured-img {
    width: 100%;
    height: 450px;
    object-fit: cover;
    object-position: center;
    border-radius: 24px;
    display: block;
  }

  @media (max-width: 1024px) {
    .post-hero-container {
      flex-direction: column;
    }
    .post-hero-text,
    .post-hero-media {
      width: 100%;
      max-width: 100%;
      flex: 1 1 100%;
    }
    .post-hero-title {
      font-size: 48px;
    }
  }

  @media (max-width: 767px) {
    .post-hero {
      padding: 12% 4% 8%;
    }
    .post-hero-title {
      font-size: 34px;
      line-height: 1.2em;
    }
    .post-featured-img {
      height: 260px;
    }
  }

  /* --------------------------------------------------------------------------
     Container 2: Royal Blue Excerpt Banner
     -------------------------------------------------------------------------- */
  .post-excerpt-banner {
    background-color: var(--color-primary, #3456A7);
    padding: 4% 4%;
    width: 100%;
    box-sizing: border-box;
  }

  .post-narrow-container {
    max-width: 856px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .post-excerpt-text {
    font-family: "Poppins", sans-serif;
    font-size: 22px;
    font-weight: 400;
    color: var(--color-cream, #FEF9F3);
    line-height: 1.5em;
    text-transform: capitalize;
    margin: 0;
    text-align: start;
  }

  @media (max-width: 767px) {
    .post-excerpt-banner {
      padding: 6% 4%;
    }
    .post-excerpt-text {
      font-size: 18px;
    }
  }

  /* --------------------------------------------------------------------------
     Container 3: Post Content, Share, Pagination
     -------------------------------------------------------------------------- */
  .post-body-section {
    background-color: var(--color-cream, #FEF9F3);
    padding: 6% 4%;
    width: 100%;
    box-sizing: border-box;
  }

  /* Markdown Article Body Typography */
  .post-article-body {
    color: #324A6D;
    font-family: "Poppins", sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5em;
    margin-bottom: 40px;
  }

  .post-article-body p {
    font-family: "Poppins", sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: #324A6D;
    line-height: 1.5em;
    margin: 0 0 24px;
  }

  .post-article-body h2 {
    font-family: "Poppins", sans-serif;
    font-size: 32px;
    font-weight: 500;
    color: #324A6D;
    line-height: 1.2em;
    margin: 36px 0 16px;
  }

  .post-article-body h3 {
    font-family: "Poppins", sans-serif;
    font-size: 24px;
    font-weight: 500;
    color: #324A6D;
    line-height: 1.2em;
    margin: 28px 0 14px;
  }

  .post-article-body a {
    color: #3456A7;
    text-decoration: underline;
  }

  .post-article-body strong,
  .post-article-body b {
    font-family: "Poppins", sans-serif;
    font-weight: 600;
    color: #160F3F;
  }

  .post-article-body ul,
  .post-article-body ol {
    margin: 0 0 24px 24px;
    color: #324A6D;
    font-family: "Poppins", sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5em;
  }

  .post-article-body li {
    font-family: "Poppins", sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: #324A6D;
    line-height: 1.5em;
    margin-bottom: 8px;
  }

  @media (max-width: 767px) {
    .post-body-section {
      padding: 10% 4% 8%;
    }
    .post-article-body,
    .post-article-body p,
    .post-article-body li {
      font-size: 16px;
    }
    .post-article-body h2 {
      font-size: 26px;
    }
    .post-article-body h3 {
      font-size: 20px;
    }
  }

  /* Share Section */
  .post-share-section {
    margin-top: 20px;
    margin-bottom: 40px;
  }

  .post-share-label {
    font-family: "Poppins", sans-serif;
    font-size: 16px;
    font-weight: 300;
    color: #324A6D;
    line-height: 24px;
    margin-bottom: 12px;
    display: block;
  }

  .post-share-buttons {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .post-share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 6px;
    color: #FFFFFF;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .post-share-btn:hover {
    opacity: 0.85;
  }

  .share-facebook {
    background-color: #3b5998;
  }

  .share-twitter {
    background-color: #1da1f2;
  }

  .share-linkedin {
    background-color: #0077b5;
  }

  .share-icon {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  /* Pagination Navigation */
  .post-pagination {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-top: 30px;
    border-top: 1px solid rgba(50, 74, 109, 0.15);
  }

  .post-nav-col {
    flex: 1 1 50%;
  }

  .post-nav-prev .post-nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .post-nav-next .post-nav-link {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    text-align: right;
    gap: 12px;
    text-decoration: none;
  }

  .post-nav-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #324A6D;
  }

  .post-nav-meta {
    display: flex;
    flex-direction: column;
  }

  .post-nav-label {
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 300;
    color: #324A6D;
  }

  .post-nav-title {
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #160F3F;
    line-height: 1.35;
  }

  .post-nav-link:hover .post-nav-title {
    color: #3456A7;
  }

  @media (max-width: 640px) {
    .post-pagination {
      flex-direction: column;
      gap: 16px;
    }
    .post-nav-next .post-nav-link {
      justify-content: flex-start;
      text-align: left;
    }
  }

  /* --------------------------------------------------------------------------
     Container 4: Related Posts Section
     -------------------------------------------------------------------------- */
  .post-related-section {
    background-color: var(--color-primary, #3456A7);
    padding: 6% 4%;
    width: 100%;
    box-sizing: border-box;
  }

  .post-related-container {
    max-width: 1140px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .post-related-heading {
    font-family: "Angel", sans-serif;
    font-size: 64px;
    font-weight: 500;
    line-height: 64px;
    color: #FEF9F3;
    margin: 0 0 36px;
    text-align: start;
  }

  .post-related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    width: 100%;
    box-sizing: border-box;
  }

