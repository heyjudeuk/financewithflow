---
import BaseLayout from '../layouts/BaseLayout.astro';

interface PackageItem {
  id: string;
  name: string;
  subheading: string;
  desc: string;
  ideal: string;
  enquireHref: string;
  features: { label: string; included: boolean }[];
}

const allFeatures = [
  'Bookkeeping',
  'Payroll',
  'VAT',
  'CIS',
  'Year-end Accounts',
  'Corporation Tax',
  'Supplier Payments',
  'Credit Control',
  'Cashflow Management',
  'Cashflow Forecasting',
  'Management Reporting',
  'Annual Budget',
  'Board Meeting Attendance',
  'Strategic Planning',
  'Finance Director Support',
];

const packages: PackageItem[] = [
  {
    id: 'sunstone',
    name: 'Sunstone',
    subheading: 'Best for smaller businesses',
    desc: 'The foundational financial support to keep your business on track. We handle your bookkeeping, payroll, VAT, CIS, and year-end accounts so you can focus on growth with complete peace of mind.',
    ideal: 'Smaller businesses ready to move beyond basic bookkeeping and remove the stress of finances.',
    enquireHref: '/contact/?package=sunstone',
    features: allFeatures.map((f, idx) => ({
      label: f,
      included: idx <= 5, // Features 1 to 6
    })),
  },
  {
    id: 'carnelian',
    name: 'Carnelian',
    subheading: 'Businesses looking to elevate their operations',
    desc: 'Goes beyond the fundamentals with active cashflow management, credit control, forecasting, and monthly reporting. Equips you with essential tools and expert assistance to utilize your numbers to flourish.',
    ideal: 'Growing businesses aiming to elevate their financial management, operations, and strategic insight.',
    enquireHref: '/contact/?package=carnelian',
    features: allFeatures.map((f, idx) => ({
      label: f,
      included: idx <= 10, // Features 1 to 11
    })),
  },
  {
    id: 'agate',
    name: 'Agate',
    subheading: 'Designed for established businesses',
    desc: "Our full outsourced finance department service. Introduces strategic planning, annual budgeting, board meeting advisory, and bespoke Finance Director guidance to empower your company's financial success.",
    ideal: 'Established businesses seeking high-level financial leadership, investment analysis, and strategic FD support.',
    enquireHref: '/contact/?package=agate',
    features: allFeatures.map((f) => ({
      label: f,
      included: true, // All 15 features
    })),
  },
];
---

<BaseLayout
  title="Packages | Finance with Flow"
  description="Flexible outsourced finance packages - Sunstone, Carnelian and Agate - scaled to your business, from core bookkeeping to a full outsourced finance department."
  bodyClass="page-template-default page page-id-28 elementor-default elementor-kit-7 elementor-page elementor-page-28"
>
  <!-- Section 1: Hero Banner ("Find the right package for you") -->
  <section class="packages-hero-section" aria-label="Find the right package for you">
    <div class="packages-container hero-row">
      <div class="hero-left-col" data-settings='{"animation":"fadeInLeft"}'>
        <div class="heading-badge-wrap">
          <h1 class="script-heading heading-dark">Find the right package for you</h1>
        </div>
      </div>
      <div class="hero-right-col" data-settings='{"animation":"fadeInRight"}'>
        <div class="hero-paragraphs">
          <p>We understand that no two businesses are the same!</p>
          <p>
            Our outsourced finance department offers solutions that are tailored for each individual client, to meet the unique needs and goals of your business.
          </p>
          <p>Explore our packages below to see some of the things we can offer.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Packages Comparison Grid -->
  <section class="packages-grid-section" aria-label="Our Packages">
    <div class="packages-container">
      <div class="heading-badge-wrap center-badge" data-settings='{"animation":"fadeInRight"}'>
        <h2 class="script-heading heading-dark">Our Packages</h2>
      </div>

      <div class="pricing-table-wrap">
        {packages.map((pkg) => (
          <div class={`pricing-card pricing-card-${pkg.id}`} data-settings='{"animation":"fadeInUp"}'>
            <!-- Header -->
            <div class="pricing-header">
              <h3 class="pkg-title">{pkg.name}</h3>
              <span class="pkg-subheading">{pkg.subheading}</span>
            </div>

            <!-- In-Card Summary -->
            <div class="pkg-summary">
              <p class="pkg-desc">{pkg.desc}</p>
              <div class="pkg-ideal">
                <strong class="ideal-label">Ideal for:</strong> {pkg.ideal}
              </div>
            </div>

            <!-- Features List -->
            <ul class="features-list">
              {pkg.features.map((feat) => (
                <li class={`feature-item ${feat.included ? 'is-included' : 'is-excluded'}`}>
                  <div class="feature-inner">
                    {feat.included ? (
                      <svg aria-hidden="true" class="feature-icon check-icon" width="18" height="18" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                        <path fill="currentColor" d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"></path>
                      </svg>
                    ) : (
                      <svg aria-hidden="true" class="feature-icon cross-icon" width="18" height="18" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                        <path fill="currentColor" d="M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8zm0 448c-110.5 0-200-89.5-200-200S145.5 56 256 56s200 89.5 200 200-89.5 200-200 200zm101.8-262.2L295.6 256l62.2 62.2c4.7 4.7 4.7 12.3 0 17l-22.6 22.6c-4.7 4.7-12.3 4.7-17 0L256 295.6l-62.2 62.2c-4.7 4.7-12.3 4.7-17 0l-22.6-22.6c-4.7-4.7-4.7-12.3 0-17l62.2-62.2-62.2-62.2c-4.7-4.7-4.7-12.3 0-17l22.6-22.6c4.7-4.7 12.3-4.7 17 0l62.2 62.2 62.2-62.2c4.7-4.7 12.3-4.7 17 0l22.6 22.6c4.7 4.7 4.7 12.3 0 17z"></path>
                      </svg>
                    )}
                    <span class="feature-label">{feat.label}</span>
                  </div>
                </li>
              ))}
            </ul>

            <!-- Footer / CTA -->
            <div class="pricing-footer">
              <a class="fwf-btn-teal" href={pkg.enquireHref}>
                Enquire About {pkg.name}
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Pricing Note -->
      <div class="pricing-note-wrap" data-settings='{"animation":"fadeInRight"}'>
        <p class="pricing-note">Packages start from £600 + VAT per month</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* -------------------------------------------------------------
     Shared Layout & Containers
     ------------------------------------------------------------- */
  .packages-container {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
    box-sizing: border-box;
  }

  /* -------------------------------------------------------------
     Script Headings & Circle Badges
     ------------------------------------------------------------- */
  .heading-badge-wrap {
    position: relative;
    display: inline-block;
    background-image: url('/wp-content/uploads/2023/12/circle.png');
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center left;
    padding: 25px 30px 15px 15px;
    margin-bottom: 24px;
    box-sizing: border-box;
  }

  .heading-badge-wrap.center-badge {
    background-position: center center;
    padding: 25px 40px 15px 40px;
    margin-left: auto;
    margin-right: auto;
    display: table;
  }

  .script-heading {
    font-family: 'Angel', sans-serif !important;
    font-size: 4rem;
    font-weight: 400;
    line-height: 1;
    margin: 0;
    padding: 0;
  }

  .heading-dark {
    color: #160F3F !important;
  }

  /* -------------------------------------------------------------
     Section 1: Hero Banner
     ------------------------------------------------------------- */
  .packages-hero-section {
    background-color: #FEF9F3;
    padding-top: 70px;
    padding-bottom: 80px;
    box-sizing: border-box;
    width: 100%;
  }

  .hero-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
  }

  .hero-left-col {
    width: 48%;
    box-sizing: border-box;
  }

  .hero-right-col {
    width: 52%;
    box-sizing: border-box;
  }

  .hero-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hero-paragraphs p {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.15rem;
    line-height: 1.6;
    color: #160F3F;
    margin: 0;
    font-weight: 500;
  }

  /* -------------------------------------------------------------
     Section 2: Pricing Table Wrap
     ------------------------------------------------------------- */
  .packages-grid-section {
    background-color: #FFFFFF;
    padding-top: 70px;
    padding-bottom: 90px;
    box-sizing: border-box;
    width: 100%;
  }

  .pricing-table-wrap {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: stretch;
    gap: 24px;
    margin-top: 36px;
    margin-bottom: 40px;
    width: 100%;
  }

  .pricing-card {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    background-color: #FFFFFF;
    border: 1px solid #E6E6E6;
    border-radius: 12px;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* Header */
  .pricing-header {
    background-color: #3456A7;
    color: #FFFFFF;
    text-align: center;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: 120px;
  }

  .pkg-title {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 6px 0;
    line-height: 1.2;
  }

  .pkg-subheading {
    font-family: 'Quicksand', sans-serif;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.35;
    font-weight: 500;
    max-width: 260px;
  }

  /* In-Card Summary */
  .pkg-summary {
    background-color: #FAFCFB;
    border-bottom: 2px solid #E6E6E6;
    padding: 24px 24px 20px 24px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
  }

  .pkg-desc {
    font-family: 'Quicksand', sans-serif;
    font-size: 14.5px;
    line-height: 1.6;
    color: #444F5A;
    margin: 0;
    font-weight: 500;
  }

  .pkg-ideal {
    font-family: 'Quicksand', sans-serif;
    font-size: 13.5px;
    line-height: 1.5;
    color: #144940;
    background-color: #EEF9F6;
    border-left: 3px solid #31CDB0;
    padding: 10px 14px;
    border-radius: 0 8px 8px 0;
    box-sizing: border-box;
    font-weight: 500;
    min-height: 76px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ideal-label {
    font-weight: 700;
    color: #144940;
  }

  /* Fallback for browsers without CSS subgrid */
  @supports not (grid-template-rows: subgrid) {
    .pricing-table-wrap {
      display: flex;
      flex-direction: row;
      align-items: stretch;
    }

    .pricing-card {
      display: flex;
      flex-direction: column;
      flex: 1 1 0;
    }

    .pricing-header {
      min-height: 124px;
    }

    .pkg-summary {
      min-height: 310px;
    }

    .features-list {
      flex: 1 1 auto;
    }
  }

  /* Features List */
  .features-list {
    list-style: none;
    margin: 0;
    padding: 16px 0;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  .feature-item {
    padding: 12px 24px;
    border-bottom: 1px solid #F0F0F0;
    box-sizing: border-box;
  }

  .feature-item:last-child {
    border-bottom: none;
  }

  .feature-inner {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .feature-icon,
  svg.feature-icon {
    width: 18px !important;
    height: 18px !important;
    max-width: 18px !important;
    max-height: 18px !important;
    flex: 0 0 18px !important;
    display: block !important;
  }

  .check-icon {
    color: #31CDB0 !important;
  }

  .cross-icon {
    color: #C4C4C4 !important;
  }

  .feature-label {
    font-family: 'Quicksand', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #160F3F;
    line-height: 1.4;
  }

  .is-excluded .feature-label {
    color: #888888;
    font-weight: 500;
  }

  /* Footer Button */
  .pricing-footer {
    padding: 24px 20px;
    text-align: center;
    background-color: #FFFFFF;
    border-top: 1px solid #E6E6E6;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .fwf-btn-teal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #31CDB0;
    color: #FFFFFF;
    font-family: 'Quicksand', sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 35px;
    padding: 12px 28px;
    cursor: pointer;
    box-shadow: none !important;
    transform: none !important;
    transition: background-color 0.2s ease, color 0.2s ease !important;
  }

  .fwf-btn-teal:hover,
  .fwf-btn-teal:focus {
    background-color: #3456A7;
    color: #FFFFFF;
    box-shadow: none !important;
    transform: none !important;
  }

  /* Pricing Note */
  .pricing-note-wrap {
    text-align: center;
    margin-top: 20px;
  }

  .pricing-note {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.35rem;
    font-weight: 600;
    color: #160F3F;
    margin: 0;
  }

  /* -------------------------------------------------------------
     Responsive Breakpoints
     ------------------------------------------------------------- */
  @media (max-width: 1024px) {
    .pricing-table-wrap {
      display: flex;
      flex-direction: column;
      max-width: 540px;
      margin-left: auto;
      margin-right: auto;
      gap: 32px;
    }

    .pricing-card {
      display: flex;
      flex-direction: column;
      grid-row: auto;
      flex: 0 0 auto;
      width: 100%;
      height: auto;
    }

    .pricing-header {
      min-height: auto;
      padding: 22px 20px;
    }

    .pkg-subheading {
      max-width: none;
    }

    .pkg-summary {
      min-height: auto;
      height: auto;
    }

    .pkg-ideal {
      min-height: auto;
    }

    .script-heading {
      font-size: 3.2rem;
    }
  }

  @media (max-width: 768px) {
    .packages-hero-section {
      padding-top: 45px;
      padding-bottom: 50px;
    }

    .hero-row {
      flex-direction: column;
      gap: 28px;
    }

    .hero-left-col,
    .hero-right-col {
      width: 100%;
    }

    .packages-grid-section {
      padding-top: 50px;
      padding-bottom: 60px;
    }

    .pricing-note {
      font-size: 1.15rem;
    }
  }
</style>
