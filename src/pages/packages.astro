---
import BaseLayout from '../layouts/BaseLayout.astro';
import packages from '../data/packages.json';
---

<BaseLayout 
  title="Packages & Pricing | Finance with Flow"
  description="Explore our modular outsourced finance department packages: Sunstone, Carnelian, and Agate. Designed to scale with your business."
>
  <!-- Hero -->
  <section class="bg-[#FEF9F3] py-16 lg:py-20 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-[#3456A7] bg-[#3456A7]/10 mb-4">
        Transparent Modular Plans
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-[#160F3F] tracking-tight mb-4">
        Outsourced Finance Packages
      </h1>
      <p class="text-lg text-slate-600">
        We understand that no two businesses are the same. Our outsourced finance department offers tailored packages to match your unique stage of growth.
      </p>
    </div>
  </section>

  <!-- Packages Grid -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
        {packages.map(pkg => (
          <div class={`rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 ${
            pkg.highlight 
              ? 'bg-[#160F3F] text-white shadow-2xl ring-4 ring-[#31CDB0] scale-105' 
              : 'bg-white text-slate-800 border border-slate-200 shadow-md hover:shadow-xl'
          }`}>
            <div class="space-y-6">
              {pkg.highlight ? (
                <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-[#160F3F] bg-[#31CDB0]">
                  Most Popular For Scale-Ups
                </span>
              ) : (
                <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-[#3456A7] bg-[#3456A7]/10">
                  Core Package
                </span>
              )}

              <div>
                <h2 class={`text-3xl font-extrabold ${pkg.highlight ? 'text-white' : 'text-[#160F3F]'}`}>
                  {pkg.name}
                </h2>
                <p class={`text-sm mt-2 leading-relaxed ${pkg.highlight ? 'text-slate-300' : 'text-slate-600'}`}>
                  {pkg.tagline}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-200/20">
                <p class={`text-xs font-bold uppercase tracking-wider mb-4 ${pkg.highlight ? 'text-[#31CDB0]' : 'text-[#3456A7]'}`}>
                  What's Included:
                </p>
                <ul class="space-y-3.5 text-sm">
                  {pkg.features.map(feat => (
                    <li class="flex items-start gap-3">
                      <span class={`font-bold shrink-0 ${pkg.highlight ? 'text-[#31CDB0]' : 'text-[#3456A7]'}`}>✓</span>
                      <span class={pkg.highlight ? 'text-slate-200' : 'text-slate-700'}>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-8 mt-8 border-t border-slate-200/20">
              <a 
                href="/contact" 
                class={`block w-full text-center py-4 rounded-full text-sm font-bold transition-all shadow-sm ${
                  pkg.highlight 
                    ? 'bg-[#31CDB0] text-[#160F3F] hover:bg-white hover:text-[#160F3F]' 
                    : 'bg-[#3456A7] text-white hover:bg-[#160F3F]'
                }`}
              >
                Inquire About {pkg.name}
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Bespoke Custom Package Option -->
      <div class="mt-20 p-8 sm:p-12 rounded-3xl bg-slate-50 border border-slate-200 text-center max-w-4xl mx-auto space-y-4">
        <h3 class="text-2xl sm:text-3xl font-bold text-[#160F3F]">
          Need A Fully Customized Scope?
        </h3>
        <p class="text-slate-600 text-base leading-relaxed max-w-2xl mx-auto">
          Whether you require specific help with project margin analysis, back-office migration to Xero, or interim Finance Director leadership for a funding round, we create custom scopes tailored to your exact timeline.
        </p>
        <div class="pt-4">
          <a 
            href="/contact" 
            class="inline-block px-8 py-4 rounded-full text-base font-bold text-white bg-[#3456A7] hover:bg-[#160F3F] transition-colors"
          >
            Request A Custom Proposal
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
