  <script is:inline>
    (function () {
      function equalizeHeights() {
        const summaries = Array.from(document.querySelectorAll('.fwf-package-summary'));
        const headers = Array.from(document.querySelectorAll('.elementor-price-table__header'));
        
        if (!summaries.length || !headers.length) return;

        // Mobile fallback (< 768px): Let them size naturally as stacked cards
        if (window.innerWidth < 768) {
          headers.forEach(el => el.style.removeProperty('height'));
          summaries.forEach(el => el.style.removeProperty('height'));
          return;
        }

        // 1. Reset heights first to measure true content dimensions
        headers.forEach(el => el.style.removeProperty('height'));
        summaries.forEach(el => el.style.removeProperty('height'));

        // 2. Measure max header height
        let maxHeaderH = 0;
        headers.forEach(el => {
          const h = el.offsetHeight;
          if (h > maxHeaderH) maxHeaderH = h;
        });

        // 3. Measure max summary height
        let maxSummaryH = 0;
        summaries.forEach(el => {
          const s = el.offsetHeight;
          if (s > maxSummaryH) maxSummaryH = s;
        });

        // 4. Apply synchronized heights
        if (maxHeaderH > 0) {
          headers.forEach(el => el.style.setProperty('height', maxHeaderH + 'px', 'important'));
        }
        if (maxSummaryH > 0) {
          summaries.forEach(el => el.style.setProperty('height', maxSummaryH + 'px', 'important'));
        }
      }

      // Run on DOM ready & full window load
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', equalizeHeights);
      } else {
        equalizeHeights();
      }
      window.addEventListener('load', equalizeHeights);

      // Re-run when custom web fonts finish loading (critical for Quicksand)
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(equalizeHeights);
      }

      // Astro view transitions support
      document.addEventListener('astro:page-load', equalizeHeights);

      // Debounced resize handler for smooth responsive scaling
      let resizeTimer = null;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(equalizeHeights, 60);
      });
    })();
  </script>

