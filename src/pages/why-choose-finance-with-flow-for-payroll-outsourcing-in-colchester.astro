---
import LocationPage from '../components/location/LocationPage.astro';

const areaSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Payroll outsourcing',
  provider: {
    '@type': 'AccountingService',
    name: 'Finance with Flow',
    telephone: '+441206326610',
    email: 'undercontrol@financewithflow.com',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'The Old Slaughter House, Stour Street',
      addressLocality: 'Manningtree',
      postalCode: 'CO11 1BE',
      addressCountry: 'GB',
    },
  },
  areaServed: { '@type': 'Place', name: "Colchester" },
};

const supportItems = [
  {
    "title": "Proven Excellence",
    "text": "Our payroll outsourcing service is built on the years of experience within our team. With extensive knowledge and a proven track record, Finance and Flow brings a deep understanding of payroll complexities, ensuring precision in every aspect."
  },
  {
    "title": "Timely Payroll Processing",
    "text": "With Finance with Flow, you can rely on timely payroll processing. We understand the importance of meeting deadlines and ensuring that your employees are paid accurately and promptly."
  },
  {
    "title": "Tailored Solutions",
    "text": "We recognise that every business is unique. Our Payroll Outsourcing services are customisable to suit your specific requirements. Whether you have a small team or a large workforce, we’ve got you covered."
  },
  {
    "title": "Personable Approach",
    "text": "We adopt a personable approach that goes beyond communication. Consider us an extension of your team, working collaboratively to streamline your payroll processes. We provide regular updates, ensuring you have a clear understanding of your payroll processes and any changes implemented."
  }
];

const whyItems = [
  {
    "title": "We Are Experts",
    "text": "Our team of payroll experts brings years of experience in managing payroll for businesses of different sizes. From start-ups to established enterprises, we have the knowledge and expertise to handle your payroll efficiently."
  },
  {
    "title": "Local Insight",
    "text": "Operating in Colchester, we understand the unique local regulations and compliance requirements. Our team stays updated on the latest changes, ensuring your payroll processes align with the specific norms of the area."
  },
  {
    "title": "Cost-Efficient",
    "text": "By outsourcing your payroll to Finance with Flow, you gain access to a dedicated finance team without the need to hire and manage an in-house payroll department. This translates to significant cost savings for your business."
  },
  {
    "title": "Seamless Integration",
    "text": "Our seamless integration process ensures that the transition to outsourced payroll services is smooth and hassle-free. We work closely with your existing team to understand your payroll needs and tailor our services accordingly."
  }
