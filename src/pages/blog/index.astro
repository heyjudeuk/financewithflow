---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getCategoryDisplayName, CATEGORY_NAMES } from "../../utils/categories";

const allPosts = await getCollection("posts");

// Filter only published posts (draft articles are never rendered on the live site)
const publishedPosts = allPosts.filter(p => p.data.status === 'published');

// Sort posts chronologically descending
const sortedPosts = publishedPosts.sort((a, b) => {
  const dateA = new Date(a.data.publishedDate).getTime();
  const dateB = new Date(b.data.publishedDate).getTime();
  return dateB - dateA;
});

// Featured posts: articles where isFeatured is true (fallback to newest 3 if none flagged)
let featuredPosts = sortedPosts.filter(p => p.data.isFeatured === true);
if (featuredPosts.length === 0) {
  featuredPosts = sortedPosts.slice(0, 3);
}

// Available categories with post count in published posts
const categoriesMap = new Map<string, number>();
sortedPosts.forEach(post => {
  const cat = post.data.category || 'featured';
  categoriesMap.set(cat, (categoriesMap.get(cat) || 0) + 1);
});

const availableCategories = Array.from(categoriesMap.entries()).map(([slug, count]) => ({
  slug,
  name: getCategoryDisplayName(slug),
  count,
})).sort((a, b) => a.name.localeCompare(b.name));
---

