<style>
  /* Category Pill Bar Styling */
  .category-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    align-items: center;
    margin-bottom: 40px;
  }

  .cat-pill {
    font-family: "Quicksand", sans-serif;
    font-size: 15px;
    font-weight: 600;
    padding: 9px 20px;
    border-radius: 30px;
    border: 1.5px solid #3456A7;
    background: transparent;
    color: #3456A7;
    cursor: pointer;
    transition: all 0.25s ease;
    outline: none;
    line-height: 1.2;
  }

  .cat-pill:hover {
    background-color: #31CDB0;
    border-color: #31CDB0;
    color: #FEF9F3;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(49, 205, 176, 0.25);
  }

  .cat-pill.active {
    background-color: #3456A7;
    border-color: #3456A7;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(52, 86, 167, 0.25);
  }

  /* Pagination Styling */
  :global(.elementor-pagination .page-numbers) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: "Quicksand", sans-serif;
    font-size: 16px;
    font-weight: 600;
    min-width: 42px;
    height: 42px;
    padding: 0 14px;
    border-radius: 8px;
    border: 1.5px solid #dcdce6;
    background: #ffffff;
    color: #3456A7;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
  }

  :global(.elementor-pagination .page-numbers:hover:not(.current):not(.disabled)) {
    background: #31CDB0;
    border-color: #31CDB0;
    color: #ffffff;
    transform: translateY(-1px);
  }

  :global(.elementor-pagination .page-numbers.current) {
    background: #31CDB0;
    border-color: #31CDB0;
    color: #ffffff;
    font-weight: 700;
    box-shadow: 0 4px 10px rgba(49, 205, 176, 0.25);
  }

  :global(.elementor-pagination .page-numbers.disabled) {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }
</style>

<script>
  function initBlogArchive() {
    const CARDS_PER_PAGE = 6;
    const cards = Array.from(document.querySelectorAll('.archive-post-card')) as HTMLElement[];
    const pills = Array.from(document.querySelectorAll('.cat-pill')) as HTMLButtonElement[];
    const paginationContainer = document.getElementById('archive-pagination');
    const noPostsMsg = document.getElementById('no-posts-message');

    if (!cards.length || !paginationContainer) return;

    let currentCategory = 'all';
    let currentPage = 1;

    // Check URL parameters for initial category or page
    const urlParams = new URLSearchParams(window.location.search);
    const catParam = urlParams.get('category');
    const pageParam = parseInt(urlParams.get('page') || '1', 10);

    if (catParam && pills.some(p => p.dataset.category === catParam)) {
      currentCategory = catParam;
    }
    if (!isNaN(pageParam) && pageParam > 0) {
      currentPage = pageParam;
    }

    function render() {
      // 1. Update pills active state
      pills.forEach(p => {
        const isActive = p.dataset.category === currentCategory;
        p.classList.toggle('active', isActive);
        p.setAttribute('aria-selected', String(isActive));
      });

      // 2. Filter cards
      const visibleCards = cards.filter(card => {
        if (currentCategory === 'all') return true;
        return card.dataset.category === currentCategory;
      });

      const totalVisible = visibleCards.length;
      const totalPages = Math.ceil(totalVisible / CARDS_PER_PAGE) || 1;

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      // 3. Show/hide empty state
      if (totalVisible === 0) {
        if (noPostsMsg) noPostsMsg.style.display = 'block';
      } else {
        if (noPostsMsg) noPostsMsg.style.display = 'none';
      }

      // 4. Paginate cards
      const startIndex = (currentPage - 1) * CARDS_PER_PAGE;
      const endIndex = startIndex + CARDS_PER_PAGE;

      cards.forEach(card => {
        card.style.display = 'none';
      });

      visibleCards.forEach((card, idx) => {
        if (idx >= startIndex && idx < endIndex) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });

      // 5. Render pagination buttons
      paginationContainer.innerHTML = '';
      if (totalPages <= 1) {
        paginationContainer.style.display = 'none';
        return;
      }
      paginationContainer.style.display = 'flex';

      // Prev button
      const prevBtn = document.createElement('button');
      prevBtn.className = `page-numbers prev ${currentPage === 1 ? 'disabled' : ''}`;
      prevBtn.textContent = '« Previous';
      prevBtn.setAttribute('aria-label', 'Previous page');
      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          updateUrl();
          render();
          scrollToArchive();
        }
      });
      paginationContainer.appendChild(prevBtn);

      // Page numbers
      for (let i = 1; i <= totalPages; i++) {
        const pageBtn = document.createElement('button');
        pageBtn.className = `page-numbers ${i === currentPage ? 'current' : ''}`;
        pageBtn.textContent = String(i);
        pageBtn.setAttribute('aria-label', `Page ${i}`);
        pageBtn.addEventListener('click', () => {
          if (currentPage !== i) {
            currentPage = i;
            updateUrl();
            render();
            scrollToArchive();
          }
        });
        paginationContainer.appendChild(pageBtn);
      }

      // Next button
      const nextBtn = document.createElement('button');
      nextBtn.className = `page-numbers next ${currentPage === totalPages ? 'disabled' : ''}`;
      nextBtn.textContent = 'Next »';
      nextBtn.setAttribute('aria-label', 'Next page');
      nextBtn.addEventListener('click', () => {
        if (currentPage < totalPages) {
          currentPage++;
          updateUrl();
          render();
          scrollToArchive();
        }
      });
      paginationContainer.appendChild(nextBtn);
    }

    function updateUrl() {
      const url = new URL(window.location.href);
      if (currentCategory === 'all') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', currentCategory);
      }
      if (currentPage === 1) {
        url.searchParams.delete('page');
      } else {
        url.searchParams.set('page', String(currentPage));
      }
      window.history.replaceState({}, '', url.toString());
    }

    function scrollToArchive() {
      const section = document.querySelector('.elementor-element-archive-section');
      if (section) {
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Attach pill click events
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        const newCat = pill.dataset.category || 'all';
        if (currentCategory !== newCat) {
          currentCategory = newCat;
          currentPage = 1;
          updateUrl();
          render();
        }
      });
    });

    render();
  }

  initBlogArchive();
  document.addEventListener('astro:page-load', initBlogArchive);
</script>
