    flex-direction: column;
    position: relative;
  }

  .card-thumb-link {
    width: 100%;
    display: block;
    position: relative;
    text-decoration: none;
  }

  .card-thumb {
    width: 100%;
    padding-bottom: 70%;
    position: relative;
    overflow: hidden;
  }

  .card-badge {
    position: absolute;
    top: 0;
    right: 0;
    margin: 20px;
    background-color: #31CDB0;
    color: #FFFFFF;
    font-family: "Quicksand", sans-serif;
    font-weight: 600;
    font-size: 12px;
    border-radius: 999px;
    padding: 0.6em 1.2em;
    text-transform: uppercase;
    line-height: 1;
    z-index: 2;
    pointer-events: none;
  }

  .card-content {
    padding: 24px 26px 16px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-title {
    margin: 0 0 16px;
    line-height: 1.35;
    min-height: 2.7em; /* Guarantees consistent 2-line baseline height across cards */
  }

  .card-title a {
    color: #FEF9F3;
    font-family: "Quicksand", sans-serif;
    font-size: 20px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease, opacity 0.2s ease;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-title a:hover {
    color: #31CDB0;
  }

  .card-read-more {
    color: #FEF9F3;
    font-family: "Quicksand", sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: auto;
    margin-bottom: 12px;
    align-self: flex-start;
    text-decoration: none;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .card-read-more:hover,
  .post-card:hover .card-read-more {
    color: #31CDB0;
  }

  .card-meta {
    padding: 12px 26px;
    color: #FEF9F3;
    font-family: "Quicksand", sans-serif;
    font-size: 12px;
    border-top: 1px solid rgba(254, 249, 243, 0.2);
    margin-top: auto;
  }

  /* ----------------------------------------------------
     Pagination Styling
     ---------------------------------------------------- */
  .archive-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 50px;
  }

  :global(.archive-pagination .page-numbers) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: "Quicksand", sans-serif;
    font-size: 16px !important;
    font-weight: 600;
    min-width: 42px;
    height: 42px;
    padding: 0 14px;
    border-radius: 8px;
    border: 1.5px solid #dcdce6;
    background: #FFFFFF;
    color: #3456A7;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    user-select: none;
  }

  :global(.archive-pagination .page-numbers:hover:not(.current):not(.disabled)) {
    background: #31CDB0;
    border-color: #31CDB0;
    color: #FFFFFF;
  }

  :global(.archive-pagination .page-numbers:focus-visible) {
    outline: 2px solid #31CDB0;
    outline-offset: 2px;
  }

  :global(.archive-pagination .page-numbers.current) {
    background: #31CDB0;
    border-color: #31CDB0;
    color: #FFFFFF;
    font-weight: 700;
  }

  :global(.archive-pagination .page-numbers.disabled) {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    font-family: "Quicksand", sans-serif;
    font-size: 18px;
    color: #666666;
  }

  /* ----------------------------------------------------
     Section 3: Bottom CTA Section
     ---------------------------------------------------- */
  .bottom-cta-section {
    background-color: #FEF9F3;
    padding: 30px 20px 90px;
  }

  .bottom-cta-card {
    background-color: #3456A7;
    border-radius: 24px;
    padding: 60px 40px;
    text-align: center;
  }

  .bottom-cta-title {
    font-family: "Angel", sans-serif;
    font-size: 3.8em;
    font-weight: 400;
    color: #FEF9F3;
    margin: 0 0 20px;
    line-height: 1.15;
  }

  .bottom-cta-text {
    font-family: "Quicksand", sans-serif;
    font-size: 1.25em;
    font-weight: 500;
    color: #FEF9F3;
    max-width: 800px;
    margin: 0 auto 16px;
    line-height: 1.6;
  }

  .bottom-cta-btn {
    display: inline-block;
    background-color: #31CDB0;
    color: #FFFFFF;
    font-family: "Quicksand", sans-serif;
    font-size: 1.1em;
    font-weight: 600;
    padding: 14px 36px;
    border-radius: 9999px;
    text-decoration: none;
    margin-top: 24px;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .bottom-cta-btn:hover {
    background-color: #FEF9F3;
    color: #160F3F;
  }

  /* ----------------------------------------------------
     Responsive Breakpoints
     ---------------------------------------------------- */
  @media (max-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .insights-hero-section {
      padding: 40px 15px 15px;
    }

    .insights-hero-subtitle {
      font-size: 16px;
    }

    .featured-section {
      padding: 15px 15px 40px;
    }

    .archive-section {
      padding: 40px 15px 60px;
    }

    .section-script-title {
      font-size: 2.5em;
    }

    .heading-badge-wrap {
      padding: 10px 10px 10px;
    }

    .search-input-wrap {
      max-width: 100%;
    }

    .blog-search-input {
      font-size: 14px;
      padding: 10px 16px 10px 42px;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }

    .card-title {
      min-height: auto;
    }

    .bottom-cta-card {
      padding: 40px 20px;
    }

    .bottom-cta-title {
      font-size: 2.5em;
    }

    .bottom-cta-text {
      font-size: 1.1em;
    }
  }
</style>

<script>
  function initBlogArchive() {
    const CARDS_PER_PAGE = 6;
    const cards = Array.from(document.querySelectorAll('.archive-post-card')) as HTMLElement[];
    const pills = Array.from(document.querySelectorAll('.cat-pill')) as HTMLButtonElement[];
    const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
    const paginationContainer = document.getElementById('archive-pagination');
    const noPostsMsg = document.getElementById('no-posts-message');

    if (!cards.length || !paginationContainer) return;

    let currentCategory = 'all';
    let currentPage = 1;
    let searchQuery = '';

    // Check URL parameters for initial category, page, or search query
    const urlParams = new URLSearchParams(window.location.search);
    const catParam = urlParams.get('category');
    const pageParam = parseInt(urlParams.get('page') || '1', 10);
    const searchParam = urlParams.get('search');

    if (catParam && pills.some(p => p.dataset.category === catParam)) {
      currentCategory = catParam;
    }
    if (!isNaN(pageParam) && pageParam > 0) {
      currentPage = pageParam;
    }
    if (searchParam && searchInput) {
      searchQuery = searchParam.trim().toLowerCase();
      searchInput.value = searchParam;
    }

    function render() {
      // 1. Update pills active state
      pills.forEach(p => {
        const isActive = p.dataset.category === currentCategory;
        p.classList.toggle('active', isActive);
        p.setAttribute('aria-selected', String(isActive));
      });

      // 2. Filter cards by category AND search query
      const visibleCards = cards.filter(card => {
        const matchesCategory = currentCategory === 'all' || card.dataset.category === currentCategory;
        const cardTitle = card.dataset.title || '';
        const matchesSearch = !searchQuery || cardTitle.includes(searchQuery);
        return matchesCategory && matchesSearch;
      });

      const totalVisible = visibleCards.length;
      const totalPages = Math.ceil(totalVisible / CARDS_PER_PAGE) || 1;

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      // 3. Show/hide empty state
      if (totalVisible === 0) {
        if (noPostsMsg) noPostsMsg.style.display = 'block';
      } else {
        if (noPostsMsg) noPostsMsg.style.display = 'none';
      }

      // 4. Paginate cards
      const startIndex = (currentPage - 1) * CARDS_PER_PAGE;
      const endIndex = startIndex + CARDS_PER_PAGE;

      cards.forEach(card => {
        card.style.display = 'none';
      });

      visibleCards.forEach((card, idx) => {
        if (idx >= startIndex && idx < endIndex) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });

      // 5. Render pagination buttons
      paginationContainer.innerHTML = '';
      if (totalPages <= 1) {
        paginationContainer.style.display = 'none';
        return;
      }
      paginationContainer.style.display = 'flex';

      // Prev button
      const prevBtn = document.createElement('button');
      prevBtn.className = `page-numbers prev ${currentPage === 1 ? 'disabled' : ''}`;
      prevBtn.textContent = '« Previous';
      prevBtn.setAttribute('aria-label', 'Previous page');
      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          updateUrl();
          render();
          scrollToArchive();
        }
      });
      paginationContainer.appendChild(prevBtn);

      // Page numbers
      for (let i = 1; i <= totalPages; i++) {
        const pageBtn = document.createElement('button');
        pageBtn.className = `page-numbers ${i === currentPage ? 'current' : ''}`;
        pageBtn.textContent = String(i);
        pageBtn.setAttribute('aria-label', `Page ${i}`);
        pageBtn.addEventListener('click', () => {
          if (currentPage !== i) {
            currentPage = i;
            updateUrl();
            render();
            scrollToArchive();
          }
        });
        paginationContainer.appendChild(pageBtn);
      }

      // Next button
      const nextBtn = document.createElement('button');
      nextBtn.className = `page-numbers next ${currentPage === totalPages ? 'disabled' : ''}`;
      nextBtn.textContent = 'Next »';
      nextBtn.setAttribute('aria-label', 'Next page');
      nextBtn.addEventListener('click', () => {
        if (currentPage < totalPages) {
          currentPage++;
          updateUrl();
          render();
          scrollToArchive();
        }
      });
      paginationContainer.appendChild(nextBtn);
    }

    function updateUrl() {
      const url = new URL(window.location.href);
      if (currentCategory === 'all') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', currentCategory);
      }
      if (currentPage === 1) {
        url.searchParams.delete('page');
      } else {
        url.searchParams.set('page', String(currentPage));
      }
      if (!searchQuery) {
        url.searchParams.delete('search');
      } else {
        url.searchParams.set('search', searchQuery);
      }
      window.history.replaceState({}, '', url.toString());
    }

    function scrollToArchive() {
      const section = document.getElementById('archive-section');
      if (section) {
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Attach pill click events
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        const newCat = pill.dataset.category || 'all';
        if (currentCategory !== newCat) {
          currentCategory = newCat;
          currentPage = 1;
          updateUrl();
          render();
        }
      });
    });

    // Attach search input event with debounce
    if (searchInput) {
      let debounceTimer: ReturnType<typeof setTimeout>;
      searchInput.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          searchQuery = searchInput.value.trim().toLowerCase();
          currentPage = 1;
          updateUrl();
          render();
        }, 150);
      });
    }

    render();
  }

  initBlogArchive();
  document.addEventListener('astro:page-load', initBlogArchive);
</script>
