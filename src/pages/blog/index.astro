---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getCategoryDisplayName } from "../../utils/categories";
import ResponsiveImage from "../../components/ResponsiveImage.astro";

const allPosts = await getCollection("posts");

// Filter only published posts (draft articles are never rendered on the live site)
const publishedPosts = allPosts.filter(p => p.data.status === 'published');

// Sort posts chronologically descending
const sortedPosts = publishedPosts.sort((a, b) => {
  const dateA = new Date(a.data.publishedDate).getTime();
  const dateB = new Date(b.data.publishedDate).getTime();
  return dateB - dateA;
});

// Featured posts: articles where isFeatured is true (fallback to newest 3 if none flagged)
let featuredPosts = sortedPosts.filter(p => p.data.isFeatured === true);
if (featuredPosts.length === 0) {
  featuredPosts = sortedPosts.slice(0, 3);
}

// Available categories with post count in published posts
const categoriesMap = new Map<string, number>();
sortedPosts.forEach(post => {
  const cat = post.data.category || 'featured';
  categoriesMap.set(cat, (categoriesMap.get(cat) || 0) + 1);
});

const availableCategories = Array.from(categoriesMap.entries()).map(([slug, count]) => ({
  slug,
  name: getCategoryDisplayName(slug),
  count,
})).sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout 
  title="Insights | Finance with Flow"
  description="Explore our news & insights on outsourced finance, construction accounting, cashflow, and business growth."
>
  <!-- SECTION 0: Page Hero (Semantic H1) -->
  <section class="insights-hero-section" aria-label="News and Insights">
    <div class="insights-hero-container">
      <div class="heading-badge-wrap">
        <h1 class="section-script-title">News &amp; Insights</h1>
      </div>
      <p class="insights-hero-subtitle">
        Expert perspectives, case studies, and practical guidance on outsourced finance, construction accounting, cashflow, and business growth.
      </p>
    </div>
  </section>

  <!-- SECTION 1: Featured News & Insights -->
  <section class="featured-section" aria-label="Featured Articles">
    <div class="featured-container">
      <div class="heading-badge-wrap">
        <h2 class="section-script-title">Featured Articles</h2>
      </div>

      <div class="posts-grid" role="list">
        {featuredPosts.map(post => {
          const d = new Date(post.data.publishedDate);
          const dateStr = d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
          const imgUrl = post.data.featuredImage || "/wp-content/uploads/2023/12/what-we-do.png";
          const category = getCategoryDisplayName(post.data.category);
          const postUrl = `/blog/${post.id}/`;

          return (
            <article class="post-card" role="listitem">
              <a class="card-thumb-link" href={postUrl} tabindex="-1">
                <div class="card-thumb">
                  <ResponsiveImage 
                    src={imgUrl} 
                    alt={post.data.title} 
                    loading="lazy" 
                    decoding="async"
                    width={380} 
                    height={266} 
                    style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;"
                    sizes="(max-width: 767px) 100vw, (max-width: 1024px) 50vw, 380px"
                  />
                </div>
              </a>
              <div class="card-badge">{category}</div>
              <div class="card-content">
                <h3 class="card-title">
                  <a href={postUrl}>{post.data.title}</a>
                </h3>
                <a class="card-read-more" href={postUrl} aria-label={`Read more about ${post.data.title}`} tabindex="-1">
                  READ MORE »
                </a>
              </div>
              <div class="card-meta">
                <span class="card-date">{dateStr}</span>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- SECTION 2: All Articles Archive with Category Filter, Search & 6-Card Pagination -->
  <section class="archive-section" id="archive-section" aria-label="All Insights and Articles">
    <div class="archive-container">
      <div class="heading-badge-wrap">
        <h2 class="section-script-title">All Insights &amp; Articles</h2>
      </div>
      <p class="archive-subtitle">
        Filter by category, search by keyword, or browse all our articles below.
      </p>

      <!-- Toolbar: Search Bar & Category Filter Pills -->
      <div class="archive-toolbar">
        <div class="search-input-wrap">
          <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="search" 
            id="blog-search-input" 
            class="blog-search-input" 
            placeholder="Search articles by keyword or topic..." 
            aria-label="Search articles by keyword or topic"
            autocomplete="off"
          />
        </div>

        <!-- Category Filter Pill Bar -->
        <div class="category-filter-bar" role="tablist" aria-label="Filter articles by category">
          <button class="cat-pill active" data-category="all" role="tab" aria-selected="true">
            All ({sortedPosts.length})
          </button>
          {availableCategories.map(cat => (
            <button class="cat-pill" data-category={cat.slug} role="tab" aria-selected="false">
              {cat.name} ({cat.count})
            </button>
          ))}
        </div>
      </div>

      <!-- Archive Posts Grid -->
      <div id="archive-posts-container" class="posts-grid" role="list">
        {sortedPosts.map(post => {
          const d = new Date(post.data.publishedDate);
          const dateStr = d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
          const imgUrl = post.data.featuredImage || "/wp-content/uploads/2023/12/what-we-do.png";
          const catSlug = post.data.category || "featured";
          const category = getCategoryDisplayName(catSlug);
          const postUrl = `/blog/${post.id}/`;

          return (
            <article 
              class="post-card archive-post-card" 
              data-category={catSlug}
              data-title={post.data.title.toLowerCase()}
              role="listitem"
            >
              <a class="card-thumb-link" href={postUrl} tabindex="-1">
                <div class="card-thumb">
                  <ResponsiveImage 
                    src={imgUrl} 
                    alt={post.data.title} 
                    loading="lazy" 
                    decoding="async"
                    width={380} 
                    height={266} 
                    style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;"
                    sizes="(max-width: 767px) 100vw, (max-width: 1024px) 50vw, 380px"
                  />
                </div>
              </a>
              <div class="card-badge">{category}</div>
              <div class="card-content">
                <h3 class="card-title">
                  <a href={postUrl}>{post.data.title}</a>
                </h3>
                <a class="card-read-more" href={postUrl} aria-label={`Read more about ${post.data.title}`} tabindex="-1">
                  READ MORE »
                </a>
              </div>
              <div class="card-meta">
                <span class="card-date">{dateStr}</span>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Empty State -->
      <div id="no-posts-message" class="empty-state" style="display: none;">
        <p>No articles found matching your criteria. Try adjusting your search or category filter.</p>
      </div>

      <!-- Pagination Bar (6 Cards Per Page) -->
      <nav id="archive-pagination" class="archive-pagination" aria-label="Pagination">
        <!-- Populated by JavaScript -->
      </nav>
    </div>
  </section>

  <!-- SECTION 3: Bottom CTA Section -->
  <section class="bottom-cta-section">
    <div class="bottom-cta-container">
      <div class="bottom-cta-card">
        <h2 class="bottom-cta-title">Join the Finance with Flow Journey</h2>
        <p class="bottom-cta-text">
          Let’s work together to not only achieve financial goals but to exceed them while staying true to the heart and soul of your business.
        </p>
        <p class="bottom-cta-text">
          We’re here to help – contact us to today, to discuss your requirements and let’s shape your success together.
        </p>
        <a class="bottom-cta-btn" href="/contact/">
          Contact us today
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ----------------------------------------------------
     Section 0: Hero Intro
     ---------------------------------------------------- */
  .insights-hero-section {
    background-color: #FEF9F3;
    padding: 60px 20px 20px;
    text-align: center;
  }

  .insights-hero-container {
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
  }

  .insights-hero-subtitle {
    font-family: "Quicksand", sans-serif;
    font-size: 19px;
    font-weight: 500;
    color: #444444;
    line-height: 1.6;
    margin: 10px auto 0;
    max-width: 720px;
  }

  /* ----------------------------------------------------
     Section 1 & 2: Base Layout & Badged Script Titles
     ---------------------------------------------------- */
  .featured-section {
    background-color: #FEF9F3;
    padding: 30px 20px 60px;
  }

  .archive-section {
    background-color: #FEF9F3;
    padding: 50px 20px 80px;
    border-top: 1px solid rgba(22, 15, 63, 0.08);
  }

  .featured-container,
  .archive-container,
  .bottom-cta-container {
    max-width: 1140px;
    margin: 0 auto;
    width: 100%;
  }

  .heading-badge-wrap {
    background-image: url(/wp-content/uploads/2023/12/circle.png);
    background-position: center center;
    background-repeat: no-repeat;
    background-size: contain;
    padding: 25px 20px 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 25px;
  }

  .section-script-title {
    font-family: "Angel", sans-serif;
    font-size: 4em;
    font-weight: 400;
    color: #160F3F;
    text-align: center;
    margin: 0;
    line-height: 1.1;
  }

  .archive-subtitle {
    font-family: "Quicksand", sans-serif;
    font-size: 17px;
    font-weight: 500;
    color: #555555;
    max-width: 650px;
    margin: 0 auto 30px;
    text-align: center;
  }

  /* ----------------------------------------------------
     Toolbar: Search Input & Category Filter Pills
     ---------------------------------------------------- */
  .archive-toolbar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    margin-bottom: 45px;
  }

  .search-input-wrap {
    position: relative;
    width: 100%;
    max-width: 480px;
  }

  .search-icon {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: #3456A7;
    pointer-events: none;
    opacity: 0.6;
  }

  .blog-search-input {
    width: 100%;
    padding: 12px 20px 12px 48px;
    font-family: "Quicksand", sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #160F3F;
    background: #FFFFFF;
    border: 1.5px solid rgba(52, 86, 167, 0.25);
    border-radius: 999px;
    outline: none;
    box-shadow: 0 2px 8px rgba(22, 15, 63, 0.04);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .blog-search-input:focus {
    border-color: #31CDB0;
    box-shadow: 0 0 0 3px rgba(49, 205, 176, 0.2);
  }

  .blog-search-input::placeholder {
    color: #888888;
  }

  .category-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    align-items: center;
  }

  .cat-pill {
    font-family: "Quicksand", sans-serif;
    font-size: 15px;
    font-weight: 600;
    padding: 9px 20px;
    border-radius: 30px;
    border: 1.5px solid #3456A7;
    background: transparent;
    color: #3456A7;
    cursor: pointer;
    transition: all 0.25s ease;
    outline: none;
    line-height: 1.2;
  }

  .cat-pill:hover {
    background-color: #31CDB0;
    border-color: #31CDB0;
    color: #FEF9F3;
  }

  .cat-pill:focus-visible {
    outline: 2px solid #31CDB0;
    outline-offset: 2px;
  }

  .cat-pill.active {
    background-color: #3456A7;
    border-color: #3456A7;
    color: #FFFFFF;
  }

  /* ----------------------------------------------------
     Cards Grid & Single Card (Subgrid Alignment & Micro-Interactions)
     ---------------------------------------------------- */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    width: 100%;
  }

  .post-card {
