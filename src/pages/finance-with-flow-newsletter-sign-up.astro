---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Newsletter Sign Up | Finance with Flow"
  description="Sign up to the Finance with Flow newsletter for industry insights and practical tips for running a smooth, well-managed finance function."
>
  <section class="newsletter-page">
    <div class="newsletter-container">
      <div class="newsletter-card">
        <h1 class="newsletter-title">Stay In The Flow</h1>
        <p class="newsletter-intro">
          Sign up to our newsletter to receive the latest industry insights, and tips and tricks for a smooth-running finance team!
        </p>

        <form class="newsletter-form" name="Newsletter Sign-up" data-newsletter-form>
          <div class="form-group">
            <input
              type="email"
              name="email"
              id="newsletter-email"
              placeholder="Enter your email address"
              required
              class="newsletter-input"
              aria-label="Email address"
            />
            <button type="submit" class="newsletter-btn">
              <span class="fwf-btn-text">Join</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .newsletter-page {
    background-color: #FEF9F3;
    min-height: 55vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
  }

  .newsletter-container {
    max-width: 680px;
    width: 100%;
    margin: 0 auto;
  }

  .newsletter-card {
    background-color: #FFFFFF;
    border-radius: 24px;
    padding: 50px 40px;
    box-shadow: 0 4px 20px rgba(22, 15, 63, 0.06);
    text-align: center;
  }

  .newsletter-title {
    font-family: 'Angel', sans-serif;
    font-size: 3.5em;
    color: #160F3F;
    margin: 0 0 16px;
    line-height: 1.1;
  }

  .newsletter-intro {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.2em;
    font-weight: 500;
    color: #160F3F;
    line-height: 1.5;
    margin: 0 auto 35px;
    max-width: 520px;
  }

  .newsletter-form {
    width: 100%;
  }

  .form-group {
    display: flex;
    gap: 12px;
  }

  .newsletter-input {
    flex: 1;
    padding: 14px 20px;
    font-family: 'Quicksand', sans-serif;
    font-size: 1.05em;
    color: #160F3F;
    background-color: #F7F5F0;
    border: 1px solid transparent;
    border-radius: 8px;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .newsletter-input:focus {
    background-color: #FFFFFF;
    border-color: #31CDB0;
  }

  .newsletter-btn {
    background-color: #160F3F;
    color: #FFFFFF;
    font-family: 'Quicksand', sans-serif;
    font-size: 1.1em;
    font-weight: 600;
    padding: 14px 36px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
    flex-shrink: 0;
  }

  .newsletter-btn:hover {
    background-color: #31CDB0;
    color: #160F3F;
  }

  @media (max-width: 600px) {
    .newsletter-card {
      padding: 35px 20px;
    }

    .newsletter-title {
      font-size: 2.6em;
    }

    .newsletter-intro {
      font-size: 1.05em;
    }

    .form-group {
      flex-direction: column;
    }

    .newsletter-btn {
      width: 100%;
    }
  }
</style>
