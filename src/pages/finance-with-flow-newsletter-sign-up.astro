---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Newsletter Sign Up | Finance with Flow"
  description="Subscribe to the Finance with Flow newsletter for actionable monthly accounting advice, CIS guidance, and business finance tips."
>
  <section class="bg-[#FEF9F3] py-16 lg:py-20 border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-[#3456A7] bg-[#3456A7]/10 mb-4">
        Stay Connected
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-[#160F3F] tracking-tight mb-4">
        Finance With Flow Newsletter
      </h1>
      <p class="text-lg text-slate-600 max-w-xl mx-auto">
        Get practical financial tips, tax deadline reminders, and construction accounting updates delivered directly to your inbox once a month.
      </p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-50 p-8 sm:p-10 rounded-3xl border border-slate-200 shadow-sm text-center">
        <h2 class="text-2xl font-bold text-[#160F3F] mb-3">Join Our Monthly Digest</h2>
        <p class="text-sm text-slate-600 mb-8">No spam. Only high-value insights tailored for SME directors and construction contractors.</p>

        <form class="space-y-4 text-left" onsubmit="event.preventDefault(); alert('Thank you for subscribing to the Finance with Flow newsletter!');">
          <div>
            <label for="newsletter-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">First Name</label>
            <input 
              type="text" 
              id="newsletter-name" 
              required 
              class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-[#3456A7] focus:ring-2 focus:ring-[#3456A7]/20 bg-white text-slate-800 text-sm outline-hidden"
              placeholder="Your name"
            />
          </div>

          <div>
            <label for="newsletter-email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Email Address</label>
            <input 
              type="email" 
              id="newsletter-email" 
              required 
              class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-[#3456A7] focus:ring-2 focus:ring-[#3456A7]/20 bg-white text-slate-800 text-sm outline-hidden"
              placeholder="you@company.co.uk"
            />
          </div>

          <button 
            type="submit" 
            class="w-full py-4 rounded-full text-base font-bold text-white bg-[#3456A7] hover:bg-[#160F3F] transition-all shadow-md mt-2 cursor-pointer"
          >
            Subscribe Now
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
