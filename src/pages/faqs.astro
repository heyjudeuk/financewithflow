---
import BaseLayout from '../layouts/BaseLayout.astro';
import faqs from '../data/faqs.json';
---

<BaseLayout 
  title="Frequently Asked Questions | Finance with Flow"
  description="Answers to common questions about outsourcing your finance department, pricing, software integrations, and working with Finance with Flow."
>
  <!-- Hero -->
  <section class="bg-[#FEF9F3] py-16 lg:py-20 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-[#3456A7] bg-[#3456A7]/10 mb-4">
        Clear Answers
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-[#160F3F] tracking-tight mb-4">
        Frequently Asked Questions
      </h1>
      <p class="text-lg text-slate-600">
        Everything you need to know about partnering with our outsourced finance team.
      </p>
    </div>
  </section>

  <!-- FAQs List -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-4">
        {faqs.map((faq, index) => (
          <details class="group bg-slate-50 border border-slate-200 rounded-2xl p-6 transition-all duration-200 hover:border-[#3456A7]/40">
            <summary class="flex items-center justify-between cursor-pointer list-none font-bold text-lg text-[#160F3F] group-hover:text-[#3456A7]">
              <span>{faq.question}</span>
              <span class="ml-4 shrink-0 transition-transform duration-300 group-open:rotate-180 text-[#3456A7]">
                ▼
              </span>
            </summary>
            <div class="pt-4 text-slate-600 text-sm leading-relaxed border-t border-slate-200/60 mt-4">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>

      <!-- Have another question CTA -->
      <div class="mt-16 text-center p-8 rounded-2xl bg-[#FEF9F3] border border-slate-200">
        <h3 class="text-xl font-bold text-[#160F3F]">Still Have Questions?</h3>
        <p class="text-slate-600 text-sm mt-2 mb-6">
          We would love to discuss how our finance solutions can fit your specific business model.
        </p>
        <a 
          href="/contact" 
          class="inline-block px-8 py-3.5 rounded-full text-sm font-bold text-white bg-[#3456A7] hover:bg-[#160F3F] transition-colors shadow-sm"
        >
          Book A Free Discovery Call
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
