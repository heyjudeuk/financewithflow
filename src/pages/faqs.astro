<script>
  // Interactive accordion logic for FAQs
  document.querySelectorAll('.elementor-tab-title').forEach(tab => {
    const toggle = () => {
      const isExpanded = tab.getAttribute('aria-expanded') === 'true';
      tab.setAttribute('aria-expanded', String(!isExpanded));
      tab.classList.toggle('elementor-active');
      const content = tab.nextElementSibling;
      if (content && content.classList.contains('elementor-tab-content')) {
        content.classList.toggle('elementor-active');
        if (content.classList.contains('elementor-active')) {
          (content as HTMLElement).style.display = 'block';
        } else {
          (content as HTMLElement).style.display = 'none';
        }
      }
    };

    tab.addEventListener('click', toggle);

    // These triggers are <div role="button">, so the browser gives them no
    // built-in keyboard activation: without this they are focusable but unusable.
    tab.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      if (key === 'Enter' || key === ' ' || key === 'Spacebar') {
        event.preventDefault();
        toggle();
      }
    });
  });
</script>

