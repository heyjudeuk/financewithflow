---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Services | Finance with Flow"
  description="Outsourced finance services including management accounts, bookkeeping, payroll, CIS and credit control - delivered by a dedicated finance team for your business."
  bodyClass="page-template-default page"
>
  <!-- Section 1: Top Services Grid ("Expertise at your fingertips") -->
  <section class="services-hero-section" aria-label="Our Services">
    <div class="services-container">
      <div class="heading-badge-wrap" data-settings='{"animation":"fadeInRight"}'>
        <h1 class="script-heading heading-dark">Expertise at your fingertips</h1>
      </div>

      <div class="services-grid">
        <!-- Card 1: Strategy & Governance (White) -->
        <div class="service-card card-white" data-settings='{"animation":"fadeInLeft"}'>
          <div class="card-icon-wrap">
            <svg aria-hidden="true" class="fwf-service-icon" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
              <path fill="currentColor" d="M74 208H64a16 16 0 0 0-16 16v16a16 16 0 0 0 16 16h15.94A535.78 535.78 0 0 1 64 384h128a535.78 535.78 0 0 1-15.94-128H192a16 16 0 0 0 16-16v-16a16 16 0 0 0-16-16h-10l33.89-90.38a16 16 0 0 0-15-21.62H144V64h24a8 8 0 0 0 8-8V40a8 8 0 0 0-8-8h-24V8a8 8 0 0 0-8-8h-16a8 8 0 0 0-8 8v24H88a8 8 0 0 0-8 8v16a8 8 0 0 0 8 8h24v32H55.09a16 16 0 0 0-15 21.62zm173.16 251.58L224 448v-16a16 16 0 0 0-16-16H48a16 16 0 0 0-16 16v16L8.85 459.58A16 16 0 0 0 0 473.89V496a16 16 0 0 0 16 16h224a16 16 0 0 0 16-16v-22.11a16 16 0 0 0-8.84-14.31zm92.77-157.78l-3.29 82.2h126.72l-3.29-82.21 24.6-20.79A32 32 0 0 0 496 256.54V198a6 6 0 0 0-6-6h-26.38a6 6 0 0 0-6 6v26h-24.71v-26a6 6 0 0 0-6-6H373.1a6 6 0 0 0-6 6v26h-24.71v-26a6 6 0 0 0-6-6H310a6 6 0 0 0-6 6v58.6a32 32 0 0 0 11.36 24.4zM384 304a16 16 0 0 1 32 0v32h-32zm119.16 155.58L480 448v-16a16 16 0 0 0-16-16H336a16 16 0 0 0-16 16v16l-23.15 11.58a16 16 0 0 0-8.85 14.31V496a16 16 0 0 0 16 16h192a16 16 0 0 0 16-16v-22.11a16 16 0 0 0-8.84-14.31z"></path>
            </svg>
          </div>
          <h2 class="card-title">Strategy &amp; Governance</h2>
          <p class="card-desc">
            Support with building strong finance strategies and good governance – providing a solid foundation for your business.
          </p>
        </div>

        <!-- Card 2: Outsourced Finance Department (White) -->
        <div class="service-card card-white" data-settings='{"animation":"fadeInLeft","animation_delay":150}'>
          <div class="card-icon-wrap">
            <svg aria-hidden="true" class="fwf-service-icon" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
              <path fill="currentColor" d="M496 128v16a8 8 0 0 1-8 8h-24v12c0 6.627-5.373 12-12 12H60c-6.627 0-12-5.373-12-12v-12H24a8 8 0 0 1-8-8v-16a8 8 0 0 1 4.941-7.392l232-88a7.996 7.996 0 0 1 6.118 0l232 88A8 8 0 0 1 496 128zm-24 304H40c-13.255 0-24 10.745-24 24v16a8 8 0 0 0 8 8h464a8 8 0 0 0 8-8v-16c0-13.255-10.745-24-24-24zM96 192v192H60c-6.627 0-12 5.373-12 12v20h416v-20c0-6.627-5.373-12-12-12h-36V192h-64v192h-64V192h-64v192h-64V192H96z"></path>
            </svg>
          </div>
          <h2 class="card-title">Outsourced Finance Department</h2>
          <p class="card-desc">
            All of the day to day support and information to run your business efficiently and effectively.
          </p>
        </div>

        <!-- Card 3: Distressed Situations (Teal) -->
        <div class="service-card card-teal" data-settings='{"animation":"fadeInRight"}'>
          <div class="card-icon-wrap">
            <svg aria-hidden="true" class="fwf-service-icon" viewBox="0 0 352 512" xmlns="http://www.w3.org/2000/svg">
              <path fill="currentColor" d="M96.06 454.35c.01 6.29 1.87 12.45 5.36 17.69l17.09 25.69a31.99 31.99 0 0 0 26.64 14.28h61.71a31.99 31.99 0 0 0 26.64-14.28l17.09-25.69a31.989 31.989 0 0 0 5.36-17.69l.04-38.35H96.01l.05 38.35zM0 176c0 44.37 16.45 84.85 43.56 115.78 16.52 18.85 42.36 58.23 52.21 91.45.04.26.07.52.11.78h160.24c.04-.26.07-.51.11-.78 9.85-33.22 35.69-72.6 52.21-91.45C335.55 260.85 352 220.37 352 176 352 78.61 272.91-.3 175.45 0 73.44.31 0 82.97 0 176zm176-80c-44.11 0-80 35.89-80 80 0 8.84-7.16 16-16 16s-16-7.16-16-16c0-61.76 50.24-112 112-112 8.84 0 16 7.16 16 16s-7.16 16-16 16z"></path>
            </svg>
          </div>
          <h2 class="card-title">Distressed Situations</h2>
          <p class="card-desc">
            Navigating through tough financial times? We can be your guiding light. Our practical solutions are tailored to help you overcome challenges and pave a smoother path toward financial stability.
          </p>
          <p class="card-desc">
            As associate members of the Institute for Turnaround we are well placed to support you in difficult times.
          </p>
        </div>

        <!-- Card 4: Systems & Controls Review (Teal, 1 col) -->
        <div class="service-card card-teal" data-settings='{"animation":"fadeInLeft"}'>
          <div class="card-icon-wrap">
            <svg aria-hidden="true" class="fwf-service-icon" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
              <path fill="currentColor" d="M200 288H88c-21.4 0-32.1 25.8-17 41l32.9 31-99.2 99.3c-6.2 6.2-6.2 16.4 0 22.6l25.4 25.4c6.2 6.2 16.4 6.2 22.6 0L152 408l31.1 33c15.1 15.1 40.9 4.4 40.9-17V312c0-13.3-10.7-24-24-24zm112-64h112c21.4 0 32.1-25.9 17-41l-33-31 99.3-99.3c6.2-6.2 6.2-16.4 0-22.6L481.9 4.7c-6.2-6.2-16.4-6.2-22.6 0L360 104l-31.1-33C313.8 55.9 288 66.6 288 88v112c0 13.3 10.7 24 24 24zm96 136l33-31.1c15.1-15.1 4.4-40.9-17-40.9H312c-13.3 0-24 10.7-24 24v112c0 21.4 25.9 32.1 41 17l31-32.9 99.3 99.3c6.2 6.2 16.4 6.2 22.6 0l25.4-25.4c6.2-6.2 6.2-16.4 0-22.6L408 360zM183 71.1L152 104 52.7 4.7c-6.2-6.2-16.4-6.2-22.6 0L4.7 30.1c-6.2 6.2-6.2 16.4 0 22.6L104 152l-33 31.1C55.9 198.2 66.6 224 88 224h112c13.3 0 24-10.7 24-24V88c0-21.3-25.9-32-41-16.9z"></path>
            </svg>
          </div>
          <h2 class="card-title">Systems &amp; Controls Review</h2>
          <p class="card-desc">
            Streamline your financial processes with a comprehensive systems and controls review service. We will identify and pinpoint avenues for greater efficiency while always minimising risks. Let us help you pave the way for smoother processes that drive both effectiveness and security.
          </p>
        </div>

        <!-- Card 5: Attendance at Board Meetings (White, 2 cols) -->
        <div class="service-card card-white card-span-two" data-settings='{"animation":"fadeInRight"}'>
          <div class="card-icon-wrap">
            <svg aria-hidden="true" class="fwf-service-icon" viewBox="0 0 640 512" xmlns="http://www.w3.org/2000/svg">
              <path fill="currentColor" d="M96 224c35.3 0 64-28.7 64-64s-28.7-64-64-64-64 28.7-64 64 28.7 64 64 64zm448 0c35.3 0 64-28.7 64-64s-28.7-64-64-64-64 28.7-64 64 28.7 64 64 64zm32 32h-64c-17.6 0-33.5 7.1-45.1 18.6 40.3 22.1 68.9 62 75.1 109.4h66c17.7 0 32-14.3 32-32v-32c0-35.3-28.7-64-64-64zm-256 0c61.9 0 112-50.1 112-112S381.9 32 320 32 208 82.1 208 144s50.1 112 112 112zm76.8 32h-8.3c-20.8 10-43.9 16-68.5 16s-47.6-6-68.5-16h-8.3C179.6 288 128 339.6 128 403.2V432c0 26.5 21.5 48 48 48h288c26.5 0 48-21.5 48-48v-28.8c0-63.6-51.6-115.2-115.2-115.2zm-223.7-13.4C161.5 263.1 145.6 256 128 256H64c-35.3 0-64 28.7-64 64v32c0 17.7 14.3 32 32 32h65.9c6.3-47.4 34.9-87.3 75.2-109.4z"></path>
            </svg>
          </div>
          <h2 class="card-title">Attendance at Board Meetings</h2>
          <p class="card-desc">
            Benefit from our financial insights directly in your board meetings, leveraging our expertise to inform critical decisions.
          </p>
          <p class="card-desc">
            At Finance with Flow, we are committed to being more than just a service provider – we are your partners in financial success. With a tailored approach and a team of experts by your side, we’re ready to support your business’s financial journey every step of the way. Contact us today to embark on a prosperous future together.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: "Are We A Match?" -->
  <section class="services-match-section" aria-label="Are We A Match?">
    <div class="services-container match-container" data-settings='{"animation":"fadeInRight"}'>
      <div class="heading-badge-wrap match-badge">
        <h2 class="script-heading heading-white">Are We A Match?</h2>
      </div>
      <div class="match-paragraphs">
        <p>
          Our expertise lies in supporting construction companies with annual turnovers between £1 million and £15 million, helping them improve cash flow, increase profitability and make confident finance decisions.
        </p>
        <h3 class="match-subtitle">Not quite there yet?</h3>
        <p>
          We also support smaller construction businesses, subcontractors and sole traders who are building strong foundations.
        </p>
        <p>
          Wherever you are in your business journey, our goal is the same, to provide practical finance support, clear insights and guidance.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 3: "We Can Help" CTA Section -->
  <section class="services-cta-section" aria-label="We Can Help">
    <div class="services-container cta-row">
      <div class="cta-media-col" data-settings='{"animation":"fadeInLeft","animation_delay":250}'>
        <div class="cta-photo-card">
          <img
            class="cta-photo"
            src="/wp-content/uploads/2025/07/construction-accountants-1-1024x683.webp"
            srcset="/wp-content/uploads/2025/07/construction-accountants-1-1024x683.webp 1024w, /wp-content/uploads/2025/07/construction-accountants-1-300x200.webp 300w, /wp-content/uploads/2025/07/construction-accountants-1-768x512.webp 768w, /wp-content/uploads/2025/07/construction-accountants-1-1536x1024.webp 1536w"
            sizes="(max-width: 800px) 100vw, 480px"
            width="480"
            height="320"
            alt="Construction accountant working on architectural plans"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <div class="cta-text-col" data-settings='{"animation":"fadeInRight"}'>
        <div class="heading-badge-wrap">
          <h2 class="script-heading heading-dark">We Can Help</h2>
        </div>
        <div class="cta-paragraphs">
          <p>
            Are you ready to turn things around and gain back control of your company’s financial needs? Or maybe you’re simply looking to step it up a gear?
          </p>
          <p>
            Finance with Flow can help.
          </p>
          <p>
            Contact us today and let’s chat through your needs. We can shape your success together.
          </p>
        </div>
        <div class="cta-button-wrap">
          <a class="fwf-btn-teal" href="/contact/">Get in touch</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* -------------------------------------------------------------
     Shared Layout & Containers
     ------------------------------------------------------------- */
  .services-container {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
    box-sizing: border-box;
  }

  /* -------------------------------------------------------------
     Script Headings & Circle Badges
     ------------------------------------------------------------- */
  .heading-badge-wrap {
    position: relative;
    display: inline-block;
    background-image: url('/wp-content/uploads/2023/12/circle.webp');
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center left;
    padding: 25px 30px 15px 15px;
    margin-bottom: 30px;
    box-sizing: border-box;
  }

  .script-heading {
    font-family: 'Angel', sans-serif !important;
    font-size: 4rem;
    font-weight: 400;
    line-height: 1;
    margin: 0;
    padding: 0;
  }

  .heading-dark {
    color: #160F3F !important;
  }

  .heading-white {
    color: #FFFFFF !important;
  }

  /* -------------------------------------------------------------
     Section 1: Hero & Services Grid
     ------------------------------------------------------------- */
  .services-hero-section {
    background-color: #FEF9F3;
    padding-top: 70px;
    padding-bottom: 90px;
    box-sizing: border-box;
    width: 100%;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 10px;
  }

  .service-card {
    border-radius: 24px;
    padding: 44px 34px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .card-span-two {
    grid-column: span 2;
  }

  .card-white {
    background-color: #FFFFFF;
  }

  .card-teal {
    background-color: #31CDB0;
  }

  .card-icon-wrap {
    display: flex;
    align-items: center;
    margin-bottom: 4px;
  }

  .fwf-service-icon {
    width: 48px;
    height: 48px;
    color: #160F3F;
    display: block;
  }

  .card-title {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
    color: #160F3F;
    margin: 0;
    padding: 0;
  }

  .card-desc {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.15rem;
    line-height: 1.6;
    color: #160F3F;
    margin: 0;
    padding: 0;
    font-weight: 500;
  }

  /* -------------------------------------------------------------
     Section 2: Are We A Match?
     ------------------------------------------------------------- */
  .services-match-section {
    background-color: #3456A7;
    padding-top: 80px;
    padding-bottom: 90px;
    box-sizing: border-box;
    width: 100%;
  }

  .match-container {
    max-width: 900px;
  }

  .match-badge {
    margin-bottom: 24px;
  }

  .match-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .match-paragraphs p {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.2rem;
    line-height: 1.65;
    color: #FFFFFF;
    margin: 0;
    font-weight: 500;
  }

  .match-subtitle {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 8px 0 0 0;
    line-height: 1.3;
  }

  /* -------------------------------------------------------------
     Section 3: We Can Help CTA
     ------------------------------------------------------------- */
  .services-cta-section {
    background-color: #FEF9F3;
    padding-top: 80px;
    padding-bottom: 90px;
    box-sizing: border-box;
    width: 100%;
  }

  .cta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
  }

  .cta-media-col {
    width: 46%;
    box-sizing: border-box;
  }

  .cta-text-col {
    width: 50%;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .cta-photo-card {
    width: 100%;
    overflow: hidden;
    border-radius: 24px;
    display: flex;
    justify-content: center;
  }

  .cta-photo {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 24px;
    display: block;
  }

  .cta-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 28px;
  }

  .cta-paragraphs p {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.15rem;
    line-height: 1.6;
    color: #160F3F;
    margin: 0;
    font-weight: 500;
  }

  .cta-button-wrap {
    display: flex;
    align-items: center;
  }

  /* Shared Button */
  .fwf-btn-teal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #31CDB0;
    color: #FFFFFF;
    font-family: 'Quicksand', sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 35px;
    padding: 14px 34px;
    cursor: pointer;
    box-shadow: none !important;
    transform: none !important;
    transition: background-color 0.2s ease, color 0.2s ease !important;
  }

  .fwf-btn-teal:hover,
  .fwf-btn-teal:focus {
    background-color: #3456A7;
    color: #FFFFFF;
    box-shadow: none !important;
    transform: none !important;
  }

  /* -------------------------------------------------------------
     Responsive Breakpoints
     ------------------------------------------------------------- */
  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .card-span-two {
      grid-column: span 2;
    }

    .script-heading {
      font-size: 3.2rem;
    }
  }

  @media (max-width: 768px) {
    .services-hero-section,
    .services-match-section,
    .services-cta-section {
      padding-top: 50px;
      padding-bottom: 50px;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .card-span-two {
      grid-column: span 1;
    }

    .cta-row {
      flex-direction: column;
      gap: 32px;
    }

    .cta-media-col,
    .cta-text-col {
      width: 100% !important;
    }

    .script-heading {
      font-size: 2.8rem;
    }

    .match-subtitle {
      font-size: 1.35rem;
    }
  }
</style>
