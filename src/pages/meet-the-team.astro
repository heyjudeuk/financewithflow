---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Meet The Team | Finance with Flow"
  description="Meet the Finance with Flow team - the qualified accountants, bookkeepers and payroll specialists who become your outsourced finance department."
  bodyClass="page-template-default page page-id-24 elementor-default elementor-kit-7 elementor-page elementor-page-24"
>
  <!-- Hero Banner: Our team members -->
  <section class="team-hero-banner" aria-label="Our team members">
    <div class="team-container">
      <div class="hero-badge-wrap" data-settings='{"animation":"fadeInRight"}'>
        <h1 class="script-heading heading-dark hero-title">Our team members</h1>
      </div>
    </div>
  </section>

  <!-- Member 1: Roz (Blue background, Text Left, Photo Right) -->
  <section class="team-member-section bg-blue" aria-label="Roz - Managing Director">
    <div class="team-container team-member-row">
      <div class="member-text-col" data-settings='{"animation":"fadeInRight"}'>
        <div class="name-badge-wrap">
          <h2 class="script-heading heading-white">Roz</h2>
        </div>
        <h3 class="member-role text-white">Managing Director</h3>
        <div class="member-bio text-white">
          <p>
            Roz is the founder of Finance with Flow. A Chartered Accountant (FCA) with over 20 years of experience in setting up and leading Finance teams across small and large corporations, Roz built up a strong team of professionals who have expertise that cover all aspects of finance, providing other businesses with a ready-made Outsourced Finance Department.
          </p>
          <p>
            Roz embodies her desire to enable businesses to thrive through Finance with Flow, who would not be able to access this with in-house personnel.
          </p>
          <p>
            Outside of finance, Roz is a Mum of one, spending most weekends as taxi to the local mountain bike perks. She is a passionate advocate for holistic well-being and yoga, embracing a mindful and balanced lifestyle.
          </p>
        </div>
      </div>
      <div class="member-photo-col">
        <div class="photo-card-wrap">
          <img
            class="member-photo"
            src="/wp-content/uploads/2023/12/Headshot-of-Rozalynne-Johnson-1024x1024.jpg"
            srcset="/wp-content/uploads/2023/12/Headshot-of-Rozalynne-Johnson-1024x1024.jpg 1024w, /wp-content/uploads/2023/12/Headshot-of-Rozalynne-Johnson-300x300.jpg 300w, /wp-content/uploads/2023/12/Headshot-of-Rozalynne-Johnson-768x768.jpg 768w, /wp-content/uploads/2023/12/Headshot-of-Rozalynne-Johnson-700x700.jpg 700w"
            sizes="(max-width: 800px) 100vw, 480px"
            width="480"
            height="480"
            alt="Rozalynne Johnson, Managing Director at Finance with Flow"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Member 2: Nasser (Cream background, Photo Left, Text Right) -->
  <section class="team-member-section bg-cream" aria-label="Nasser - Management and Systems Accountant">
    <div class="team-container team-member-row">
      <div class="member-photo-col">
        <div class="photo-card-wrap">
          <img
            class="member-photo"
            src="/wp-content/uploads/2023/12/Headshot-of-Nasser-Rabi-Laleh-1024x1024.jpg"
            srcset="/wp-content/uploads/2023/12/Headshot-of-Nasser-Rabi-Laleh-1024x1024.jpg 1024w, /wp-content/uploads/2023/12/Headshot-of-Nasser-Rabi-Laleh-300x300.jpg 300w, /wp-content/uploads/2023/12/Headshot-of-Nasser-Rabi-Laleh-768x768.jpg 768w, /wp-content/uploads/2023/12/Headshot-of-Nasser-Rabi-Laleh-700x700.jpg 700w"
            sizes="(max-width: 800px) 100vw, 480px"
            width="480"
            height="480"
            alt="Nasser Rabi-Laleh, Management and Systems Accountant at Finance with Flow"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <div class="member-text-col" data-settings='{"animation":"fadeInRight"}'>
        <div class="name-badge-wrap">
          <h2 class="script-heading heading-dark">Nasser</h2>
        </div>
        <h3 class="member-role text-dark">Management and Systems Accountant</h3>
        <div class="member-bio text-dark">
          <p>
            Nasser is our Management &amp; Systems Accountant at Finance with Flow who has a big passion for numbers.
          </p>
          <p>
            With over ten years of experience working in various finance roles, and being ACCA-qualified, Nasser is a self-confessed Excel geek and loves automation and streamlining processes.
          </p>
          <p>
            Nasser supports clients by providing guidance and helps them really understand their numbers, to keep them doing what they do best.
          </p>
          <p>
            Having managed various teams over the years, Nasser’s experience ensures that he always strives to make a difference!
          </p>
          <p>
            Outside of work Nasseer sings in a band, likes to host quizzes and enjoys time with the family!
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Member 3: Fi (Blue background, Text Left, Photo Right) -->
  <section class="team-member-section bg-blue" aria-label="Fi - Management Accountant">
    <div class="team-container team-member-row">
      <div class="member-text-col" data-settings='{"animation":"fadeInRight"}'>
        <div class="name-badge-wrap">
          <h2 class="script-heading heading-white">Fi</h2>
        </div>
        <h3 class="member-role text-white">Management Accountant</h3>
        <div class="member-bio text-white">
          <p>
            Fi achieved her AAT qualification and and is continuing her studies to become a CIMA qualified Management Accountant.
          </p>
          <p>
            Fi’s role at Finance with Flow allows her to really get to know our clients and become part of their team by supporting with the day to day running of the finance department, building relationships with clients team members at all levels. This allows Fi to develop a well-rounded picture of performance meaning suggestions of improvement and support any changes going forward can be provided.
          </p>
          <p>
            In Fi’s spare time she enjoys spending time with her family, getting outdoors and learning to play the piano.
          </p>
        </div>
      </div>
      <div class="member-photo-col">
        <div class="photo-card-wrap">
          <img
            class="member-photo"
            src="/wp-content/uploads/2023/12/Headshot-of-Fiona-Grange_-683x1024.jpg"
            srcset="/wp-content/uploads/2023/12/Headshot-of-Fiona-Grange_-683x1024.jpg 683w, /wp-content/uploads/2023/12/Headshot-of-Fiona-Grange_-200x300.jpg 200w, /wp-content/uploads/2023/12/Headshot-of-Fiona-Grange_-768x1151.jpg 768w, /wp-content/uploads/2023/12/Headshot-of-Fiona-Grange_-1025x1536.jpg 1025w"
            sizes="(max-width: 800px) 100vw, 480px"
            width="480"
            height="720"
            alt="Fiona Grange, Management Accountant at Finance with Flow"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Member 4: Jackie (Cream background, Text Left, Photo Right) -->
  <section class="team-member-section bg-cream" aria-label="Jackie - Bookkeeper">
    <div class="team-container team-member-row">
      <div class="member-text-col" data-settings='{"animation":"fadeInRight"}'>
        <div class="name-badge-wrap">
          <h2 class="script-heading heading-dark">Jackie</h2>
        </div>
        <h3 class="member-role text-dark">Bookkeeper</h3>
        <div class="member-bio text-dark">
          <p>
            Jackie’s role as Bookkeeper allows her to build upon expertise she acquired earlier in her career as an underwriting assistant for a Lloyds syndicate.
          </p>
          <p>
            Jackie is passionate about data accuracy and prides herself on the precision of her work.
          </p>
          <p>
            Jackie’s friendly and approachable nature means that she has great relationships with all of our clients.
          </p>
          <p>
            Outside of Bookkeeping, Jackie is a mother of two boys and an assistant tennis coach at the local prep school. She holds various LTA qualifications and is a level 3 first aider.
          </p>
        </div>
      </div>
      <div class="member-photo-col">
        <div class="photo-card-wrap">
          <img
            class="member-photo"
            src="/wp-content/uploads/2023/12/Headshot-of-Jackie-Jarvis-683x1024.jpg"
            srcset="/wp-content/uploads/2023/12/Headshot-of-Jackie-Jarvis-683x1024.jpg 683w, /wp-content/uploads/2023/12/Headshot-of-Jackie-Jarvis-200x300.jpg 200w, /wp-content/uploads/2023/12/Headshot-of-Jackie-Jarvis-768x1151.jpg 768w, /wp-content/uploads/2023/12/Headshot-of-Jackie-Jarvis-1024x1536.jpg 1024w"
            sizes="(max-width: 800px) 100vw, 480px"
            width="480"
            height="720"
            alt="Jackie Jarvis, Bookkeeper at Finance with Flow"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Member 5: Jo (Cream background, Centered text, no photo) -->
  <section class="team-member-section bg-cream jo-section" aria-label="Jo - Tax Manager">
    <div class="team-container jo-container" data-settings='{"animation":"fadeInRight"}'>
      <div class="name-badge-wrap center-badge">
        <h2 class="script-heading heading-dark">Jo</h2>
      </div>
      <h3 class="member-role text-dark text-center">Tax Manager</h3>
      <div class="member-bio text-dark text-center">
        <p>
          Jo has a wealth of experience in navigating the complexities of tax for our clients, ensuring any queries or doubts can be resolved before they become stressful.
        </p>
        <p>
          Jo is a qualified ATT and CTA, and has worked in various roles dealing with everything from self assessments to international tax.
        </p>
        <p>
          Outside of the office, Jo loves spending time with her family and enjoys running and swimming.
        </p>
      </div>
    </div>
  </section>

  <!-- Member 6: Lorri (Blue background, Photo Left, Text Right) -->
  <section class="team-member-section bg-blue" aria-label="Lorri - Marketing Manager">
    <div class="team-container team-member-row">
      <div class="member-photo-col">
        <div class="photo-card-wrap">
          <img
            class="member-photo"
            src="/wp-content/uploads/2023/12/Headshot-of-Lorri-Morley-1024x683.jpg"
            srcset="/wp-content/uploads/2023/12/Headshot-of-Lorri-Morley-1024x683.jpg 1024w, /wp-content/uploads/2023/12/Headshot-of-Lorri-Morley-300x200.jpg 300w, /wp-content/uploads/2023/12/Headshot-of-Lorri-Morley-768x512.jpg 768w, /wp-content/uploads/2023/12/Headshot-of-Lorri-Morley-1536x1025.jpg 1536w"
            sizes="(max-width: 800px) 100vw, 480px"
            width="480"
            height="320"
            alt="Lorri Morley, Marketing Manager at Finance with Flow"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <div class="member-text-col" data-settings='{"animation":"fadeInRight"}'>
        <div class="name-badge-wrap">
          <h2 class="script-heading heading-white">Lorri</h2>
        </div>
        <h3 class="member-role text-white">Marketing Manager</h3>
        <div class="member-bio text-white">
          <p>
            Lorri joins the team as Marketing Manager and has over 12 years of experience in this field.
          </p>
          <p>
            At Finance with Flow, Lorri’s role is to combine her knowledge and strategic mindset in creating a bespoke marketing plan.
          </p>
          <p>
            Understanding the business, needs and goals is what Lorri does best by immersing herself within the detail and becoming a brand rep for the company.
          </p>
          <p>
            Lorri is kept busy outside of work with her two boys! And enjoys big country walks with friends and family, Coffee shop trips and a spot of DIY and upcycling around the house.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA Section: Collaboration Photo Left, Text & Services Button Right -->
  <section class="team-cta-section" aria-label="Explore our services">
    <div class="team-container team-cta-row">
      <div class="cta-photo-col" data-settings='{"animation":"fadeInLeft","animation_delay":250}'>
        <div class="photo-card-wrap">
          <img
            class="member-photo"
            src="/wp-content/uploads/2026/01/Professional-collaboration-against-a-blue-backdrop-1024x683.png"
            srcset="/wp-content/uploads/2026/01/Professional-collaboration-against-a-blue-backdrop-1024x683.png 1024w, /wp-content/uploads/2026/01/Professional-collaboration-against-a-blue-backdrop-300x200.png 300w, /wp-content/uploads/2026/01/Professional-collaboration-against-a-blue-backdrop-768x512.png 768w, /wp-content/uploads/2026/01/Professional-collaboration-against-a-blue-backdrop.webp 1536w"
            sizes="(max-width: 800px) 100vw, 480px"
            width="480"
            height="320"
            alt="Finance with Flow team collaboration"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <div class="cta-text-col" data-settings='{"animation":"fadeInRight"}'>
        <div class="cta-paragraphs">
          <p>
            Our dedicated team is the heartbeat of our mission to empower individuals and businesses to navigate the complex world of finance with confidence and ease.
          </p>
          <p>
            With a blend of expertise, enthusiasm, and a touch of creativity, we’re here to transform financial jargon into opportunities for growth. Get to know the faces behind the solutions, and let’s embark on this journey towards prosperity together.
          </p>
        </div>
        <div class="cta-btn-wrap">
          <a class="fwf-btn-teal" href="/services/">Explore our services</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* -------------------------------------------------------------
     Shared Layout & Containers
     ------------------------------------------------------------- */
  .team-container {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
    box-sizing: border-box;
  }

  /* -------------------------------------------------------------
     Hero Banner
     ------------------------------------------------------------- */
  .team-hero-banner {
    background-color: #31CDB0;
    padding-top: 50px;
    padding-bottom: 50px;
    box-sizing: border-box;
    width: 100%;
  }

  .hero-badge-wrap {
    position: relative;
    display: inline-block;
    background-image: url('/wp-content/uploads/2023/12/cream_circle.png');
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center left;
    padding: 25px 35px 15px 20px;
    box-sizing: border-box;
  }

  .hero-title {
    font-size: 4rem;
    line-height: 1;
    margin: 0;
  }

  /* -------------------------------------------------------------
     Script Headings & Badges
     ------------------------------------------------------------- */
  .script-heading {
    font-family: 'Angel', sans-serif !important;
    font-weight: 400;
    line-height: 1;
    margin: 0;
    padding: 0;
  }

  .heading-dark {
    color: #160F3F !important;
  }

  .heading-white {
    color: #FFFFFF !important;
  }

  .name-badge-wrap {
    position: relative;
    display: inline-block;
    background-image: url('/wp-content/uploads/2023/12/circle.png');
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center left;
    padding: 20px 25px 10px 15px;
    margin-bottom: 12px;
    box-sizing: border-box;
  }

  .name-badge-wrap.center-badge {
    background-position: center center;
    padding: 20px 35px 10px 35px;
    margin-left: auto;
    margin-right: auto;
    display: table;
  }

  .name-badge-wrap .script-heading {
    font-size: 3.8rem;
  }

  /* -------------------------------------------------------------
     Member Sections: Alternating Backgrounds & Rows
     ------------------------------------------------------------- */
  .team-member-section {
    padding-top: 70px;
    padding-bottom: 70px;
    box-sizing: border-box;
    width: 100%;
  }

  .bg-blue {
    background-color: #3456A7;
  }

  .bg-cream {
    background-color: #FEF9F3;
  }

  .team-member-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
  }

  .member-text-col {
    width: 52%;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .member-photo-col {
    width: 44%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  /* Photo Cards */
  .photo-card-wrap {
    width: 100%;
    overflow: hidden;
    border-radius: 24px;
    display: flex;
    justify-content: center;
  }

  .member-photo {
    width: 100%;
    max-width: 480px;
    height: auto;
    object-fit: cover;
    border-radius: 24px;
    display: block;
  }

  /* Member Typography */
  .member-role {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 20px 0;
    line-height: 1.25;
  }

  .member-bio {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .member-bio p {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0;
    font-weight: 500;
  }

  .text-white {
    color: #FFFFFF !important;
  }

  .text-dark {
    color: #160F3F !important;
  }

  .text-center {
    text-align: center;
  }

  /* Jo Centered Section */
  .jo-container {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  /* -------------------------------------------------------------
     Bottom CTA Section (Explore our services)
     ------------------------------------------------------------- */
  .team-cta-section {
    background-color: #FEF9F3;
    padding-top: 70px;
    padding-bottom: 90px;
    box-sizing: border-box;
    width: 100%;
  }

  .team-cta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
  }

  .cta-photo-col {
    width: 45%;
    box-sizing: border-box;
  }

  .cta-text-col {
    width: 52%;
    display: flex;
    flex-direction: column;
    gap: 24px;
    box-sizing: border-box;
  }

  .cta-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cta-paragraphs p {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.15rem;
    line-height: 1.6;
    color: #160F3F;
    margin: 0;
    font-weight: 500;
  }

  .cta-btn-wrap {
    display: flex;
    align-items: center;
    margin-top: 8px;
  }

  /* Shared Button */
  .fwf-btn-teal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #31CDB0;
    color: #FFFFFF;
    font-family: 'Quicksand', sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 35px;
    padding: 14px 34px;
    cursor: pointer;
    box-shadow: none !important;
    transform: none !important;
    transition: background-color 0.2s ease, color 0.2s ease !important;
  }

  .fwf-btn-teal:hover,
  .fwf-btn-teal:focus {
    background-color: #3456A7;
    color: #FFFFFF;
    box-shadow: none !important;
    transform: none !important;
  }

  /* -------------------------------------------------------------
     Responsive Breakpoints
     ------------------------------------------------------------- */
  @media (max-width: 1024px) {
    .hero-title {
      font-size: 3.2rem;
    }

    .name-badge-wrap .script-heading {
      font-size: 3rem;
    }

    .member-role {
      font-size: 1.35rem;
    }
  }

  @media (max-width: 860px) {
    .team-hero-banner {
      padding-top: 40px;
      padding-bottom: 40px;
    }

    .team-member-section,
    .team-cta-section {
      padding-top: 50px;
      padding-bottom: 50px;
    }

    .team-member-row,
    .team-cta-row {
      flex-direction: column !important;
      gap: 32px;
    }

    .member-text-col,
    .member-photo-col,
    .cta-photo-col,
    .cta-text-col {
      width: 100% !important;
    }

    .member-photo {
      max-width: 100%;
    }
  }
</style>
