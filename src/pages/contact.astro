  bodyClass="page-template-default page page-id-228 elementor-default elementor-kit-7 elementor-page elementor-page-228"
>
  <div class="page-content">
    <Fragment set:html={`<main id="content" class="site-main post-228 page type-page status-publish hentry"><div class="page-content"><div data-elementor-type="wp-page" data-elementor-id="228" class="elementor elementor-228" data-elementor-post-type="page"><div class="elementor-element elementor-element-71614628 e-flex e-con-boxed e-con e-parent" data-id="71614628" data-element_type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}"><div class="e-con-inner"><div class="elementor-element elementor-element-7152b2a9 e-flex e-con-boxed e-con e-child" data-id="7152b2a9" data-element_type="container"><div class="e-con-inner"><div class="elementor-element elementor-element-496f96f0 elementor-widget elementor-widget-heading" data-id="496f96f0" data-element_type="widget" data-widget_type="heading.default"><div class="elementor-widget-container"><h2 class="elementor-heading-title elementor-size-default">Contact</h2></div></div><div class="elementor-element elementor-element-32f3d97c elementor-widget elementor-widget-image" data-id="32f3d97c" data-element_type="widget" data-widget_type="image.default"><div class="elementor-widget-container"> <img class="attachment-large size-large wp-image-56 " src="/wp-content/uploads/2023/12/finance-writing-white-1024x203.png" decoding="async" width="800" height="159"   alt="Finance with Flow white logo" srcset="/wp-content/uploads/2023/12/finance-writing-white-1024x203.png 1024w, /wp-content/uploads/2023/12/finance-writing-white-300x59.png 300w, /wp-content/uploads/2023/12/finance-writing-white-768x152.png 768w, /wp-content/uploads/2023/12/finance-writing-white.png 1440w" sizes="(max-width: 800px) 100vw, 800px" /></div></div><div class="elementor-element elementor-element-73b01bf0 elementor-widget elementor-widget-heading" data-id="73b01bf0" data-element_type="widget" data-widget_type="heading.default"><div class="elementor-widget-container"><h1 class="elementor-heading-title elementor-size-default">We're here to help</h1></div></div></div></div></div></div><div class="elementor-element elementor-element-135590e e-flex e-con-boxed e-con e-parent" data-id="135590e" data-element_type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}"><div class="e-con-inner"><div class="elementor-element elementor-element-902f7fc e-con-full e-flex e-con e-child" data-id="902f7fc" data-element_type="container"><div class="elementor-element elementor-element-0bd0d51 elementor-widget elementor-widget-text-editor" data-id="0bd0d51" data-element_type="widget" data-widget_type="text-editor.default"><div class="elementor-widget-container"><p>Would you like to explore how Finance with Flow can support your business’ finance needs? Book a free, no obligation discovery call with Roz now!</p></div></div><div class="elementor-element elementor-element-51c6aa2 elementor-widget elementor-widget-button" data-id="51c6aa2" data-element_type="widget" data-widget_type="button.default"><div class="elementor-widget-container"><div class="elementor-button-wrapper"> <a class="elementor-button elementor-button-link elementor-size-sm" href="${BOOKING_URL}"> <span class="elementor-button-content-wrapper"> <span class="elementor-button-text">Book now</span> </span> </a></div></div></div></div></div></div>`} />

    <section class="fwf-event-contact-section" style="background-color: #FFFFFF; padding: 50px 15px 40px; border-top: 1px solid #E8EBF2; border-bottom: 1px solid #E8EBF2;">
      <div style="max-width: 1140px; margin: 0 auto;">
        <EventPromo variant="compact" />
      </div>
    </section>

