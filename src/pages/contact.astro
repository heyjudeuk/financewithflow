---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact Us | Finance with Flow"
  description="Contact Finance with Flow to book a free discovery call or discuss your outsourced finance department, bookkeeping, and CIS accounting needs."
>
  <!-- Hero -->
  <section class="bg-[#FEF9F3] py-16 lg:py-20 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-[#3456A7] bg-[#3456A7]/10 mb-4">
        We're Here To Help
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-[#160F3F] tracking-tight mb-4">
        Get In Touch
      </h1>
      <p class="text-lg text-slate-600">
        Would you like to explore how Finance with Flow can support your business? Book a free, no-obligation discovery call with Roz now.
      </p>
    </div>
  </section>

  <!-- Contact Form & Info Grid -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Contact Details -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <h2 class="text-2xl font-bold text-[#160F3F] mb-4">
              Let's Start The Conversation
            </h2>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
              Whether you are ready to completely outsource your finance operations or simply want advice on streamlining your management reporting and CIS, we are ready to listen.
            </p>
          </div>

          <div class="space-y-6 text-sm">
            <div class="flex items-start gap-4 p-5 rounded-2xl bg-slate-50 border border-slate-200">
              <span class="text-2xl">📍</span>
              <div>
                <strong class="block text-base text-[#160F3F]">Registered Office</strong>
                <p class="text-slate-600 mt-1">
                  The Nook, Colchester Road<br />
                  Great Bromley, Colchester<br />
                  Essex, CO7 7TN, United Kingdom
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-5 rounded-2xl bg-slate-50 border border-slate-200">
              <span class="text-2xl">✉️</span>
              <div>
                <strong class="block text-base text-[#160F3F]">Email Us Directly</strong>
                <a href="mailto:undercontrol@financewithflow.com" class="text-[#3456A7] font-semibold hover:underline block mt-1">
                  undercontrol@financewithflow.com
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4 p-5 rounded-2xl bg-slate-50 border border-slate-200">
              <span class="text-2xl">⏰</span>
              <div>
                <strong class="block text-base text-[#160F3F]">Working Hours</strong>
                <p class="text-slate-600 mt-1">
                  Monday – Friday: 09:00 – 17:00
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Inquiry Form -->
        <div class="lg:col-span-7 bg-slate-50 p-8 sm:p-10 rounded-3xl border border-slate-200 shadow-sm">
          <h3 class="text-xl font-bold text-[#160F3F] mb-6">
            Send Us A Message
          </h3>

          <form class="space-y-5" onsubmit="event.preventDefault(); alert('Thank you! Your message has been received. Our team will contact you shortly.');">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Your Full Name *</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-[#3456A7] focus:ring-2 focus:ring-[#3456A7]/20 bg-white text-slate-800 text-sm outline-hidden"
                  placeholder="John Smith"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Email Address *</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-[#3456A7] focus:ring-2 focus:ring-[#3456A7]/20 bg-white text-slate-800 text-sm outline-hidden"
                  placeholder="john@company.co.uk"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Phone Number</label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-[#3456A7] focus:ring-2 focus:ring-[#3456A7]/20 bg-white text-slate-800 text-sm outline-hidden"
                  placeholder="01206 123456"
                />
              </div>

              <div>
                <label for="company" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Company Name</label>
                <input 
                  type="text" 
                  id="company" 
                  name="company" 
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-[#3456A7] focus:ring-2 focus:ring-[#3456A7]/20 bg-white text-slate-800 text-sm outline-hidden"
                  placeholder="ACME Construction Ltd"
                />
              </div>
            </div>

            <div>
              <label for="service" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">What Services Are You Interested In?</label>
              <select 
                id="service" 
                name="service" 
                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-[#3456A7] focus:ring-2 focus:ring-[#3456A7]/20 bg-white text-slate-800 text-sm outline-hidden"
              >
                <option value="fully-outsourced">Fully Outsourced Finance Team</option>
                <option value="fd-services">Financial Director Services</option>
                <option value="bookkeeping-cis">Bookkeeping & CIS Compliance</option>
                <option value="advice">Looking for Strategic Advice</option>
                <option value="general">General Enquiry</option>
              </select>
            </div>

            <div>
              <label for="source" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">How Did You Find Out About Us?</label>
              <select 
                id="source" 
                name="source" 
                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-[#3456A7] focus:ring-2 focus:ring-[#3456A7]/20 bg-white text-slate-800 text-sm outline-hidden"
              >
                <option value="recommendation">Personal Recommendation / Referral</option>
                <option value="google">Google Search</option>
                <option value="xero">Xero Advisor Directory</option>
                <option value="linkedin">LinkedIn / Social Media</option>
                <option value="event">Attended an Event</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">How Can We Help? *</label>
              <textarea 
                id="message" 
                name="message" 
                rows="4" 
                required 
                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-[#3456A7] focus:ring-2 focus:ring-[#3456A7]/20 bg-white text-slate-800 text-sm outline-hidden"
                placeholder="Tell us a little bit about your current financial setup and goals..."
              ></textarea>
            </div>

            <div class="flex items-start gap-2 pt-2">
              <input type="checkbox" id="consent" required class="mt-1 rounded text-[#3456A7] focus:ring-[#3456A7]" />
              <label for="consent" class="text-xs text-slate-600">
                By submitting this form, you agree to our <a href="/privacy-policy" class="text-[#3456A7] underline">Privacy Policy</a> and <a href="/terms-conditions" class="text-[#3456A7] underline">Terms & Conditions</a>.
              </label>
            </div>

            <button 
              type="submit" 
              class="w-full py-4 rounded-full text-base font-bold text-white bg-[#3456A7] hover:bg-[#160F3F] transition-all shadow-md hover:shadow-lg mt-4 cursor-pointer"
            >
              Submit Inquiry
            </button>
          </form>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
