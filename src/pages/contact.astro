---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventPromo from '../components/EventPromo.astro';
import { BOOKING_URL } from '../data/bookingConfig';
---

<BaseLayout
  title="Contact | Finance with Flow"
  description="Get in touch with Finance with Flow. Call 01206 326610 or email undercontrol@financewithflow.com to talk about your outsourced finance needs."
>
  <!-- Hero Section -->
  <section class="contact-hero">
    <div class="hero-overlay"></div>
    <div class="hero-container">
      <span class="hero-subtitle">Contact</span>
      <div class="hero-logo-wrapper">
        <img
          src="/wp-content/uploads/2023/12/finance-writing-white-1024x203.png"
          alt="Finance with Flow"
          class="hero-logo"
          width="800"
          height="159"
          loading="eager"
          decoding="async"
        />
      </div>
      <h1 class="hero-tagline">We're here to help</h1>
    </div>
  </section>

  <!-- Discovery Call Section -->
  <section class="discovery-section">
    <div class="discovery-container">
      <p class="discovery-text">
        Would you like to explore how Finance with Flow can support your business’ finance needs? Book a free, no obligation discovery call with Roz now!
      </p>
      <a href={BOOKING_URL} class="discovery-btn" target="_blank" rel="noopener noreferrer">
        Book now
      </a>
    </div>
  </section>

  <!-- Event Promo Section -->
  <section class="event-section">
    <div class="event-container">
      <EventPromo variant="compact" />
    </div>
  </section>

  <!-- Form Section -->
  <section class="form-section">
    <div class="form-container">
      <p class="form-intro">
        Please fill out the form and press the submit button. We will get back to you as soon as possible.
      </p>

      <form
        class="contact-form"
        method="POST"
        name="Contact Form"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        aria-label="Contact Form"
      >
        <input type="hidden" name="form-name" value="Contact Form" />
        <p class="hidden-honeypot" style="display: none;" aria-hidden="true">
          <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" /></label>
        </p>

        <div class="form-grid">
          <div class="form-group col-half">
            <input
              type="text"
              name="firstname"
              id="form-field-firstname"
              placeholder="First Name"
              class="form-input"
            />
          </div>

          <div class="form-group col-half">
            <input
              type="text"
              name="lastname"
              id="form-field-lastname"
              placeholder="Last Name"
              required
              class="form-input"
            />
          </div>

          <div class="form-group col-half">
            <input
              type="tel"
              name="phone"
              id="form-field-number"
              placeholder="Contact Number"
              required
              pattern="[0-9()#&amp;+*-=.]+"
              title="Only numbers and phone characters (#, -, *, etc) are accepted."
              class="form-input"
            />
          </div>

          <div class="form-group col-half">
            <input
              type="email"
              name="email"
              id="form-field-email"
              placeholder="Email"
              required
              class="form-input"
            />
          </div>

          <div class="form-group col-full">
            <input
              type="text"
              name="sector"
              id="form-field-sector"
              placeholder="Your Business Sector"
              required
              class="form-input"
            />
          </div>

          <div class="form-group col-full">
            <label for="form-field-services" class="form-label">
              What Services Are You Interested In? *
            </label>
            <div class="select-wrapper">
              <select name="services" id="form-field-services" class="form-select" required>
                <option value="Fully Outsourced Finance Team">Fully Outsourced Finance Team</option>
                <option value="Financial Director Services">Financial Director Services</option>
                <option value="Looking for advice">Looking for advice</option>
                <option value="General Enquiry">General Enquiry</option>
                <option value="Small Business community (To commence from August 2024)">Small Business community (To commence from August 2024)</option>
              </select>
            </div>
          </div>

          <div class="form-group col-full">
            <input
              type="text"
              name="message"
              id="form-field-moreabout"
              placeholder="Tell us more about you?"
              class="form-input"
            />
          </div>

          <div class="form-group col-full">
            <label for="form-field-hearaboutus" class="form-label">
              How did you find out about us? *
            </label>
            <div class="select-wrapper">
              <select name="hearaboutus" id="form-field-hearaboutus" class="form-select" required>
                <option value="Recommendations">Recommendations</option>
                <option value="Website">Website</option>
                <option value="Search engine eg. Google">Search engine eg. Google</option>
                <option value="Xero">Xero</option>
                <option value="Social Media">Social Media</option>
                <option value="Advertising">Advertising</option>
                <option value="Attended an event">Attended an event</option>
                <option value="Advertisment">Advertisment</option>
              </select>
            </div>
          </div>

          <div class="form-group col-full checkbox-group">
            <label class="checkbox-label" for="form-field-field_a44fdac">
              <input
                type="checkbox"
                name="newsletter_opt_in"
                id="form-field-field_a44fdac"
                class="form-checkbox"
                required
                checked
              />
              <span>By submitting this form you agree to sign up to our newsletter (opt-out possible by unsubscribing) and agree to our terms and conditions and privacy policy.</span>
            </label>
          </div>

          <div class="form-group col-full submit-group">
            <button type="submit" class="submit-btn">
              Send
            </button>
          </div>
        </div>
      </form>
    </div>
  </section>

  <!-- Bottom Info Section -->
  <section class="info-section">
    <div class="info-container">
      <div class="info-item">
        <div class="info-icon">
          <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="36" height="36">
            <path fill="#160F3F" d="M502.3 190.8c3.9-3.1 9.7-.2 9.7 4.7V400c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V195.6c0-5 5.7-7.8 9.7-4.7 22.4 17.4 52.1 39.5 154.1 113.6 21.1 15.4 56.7 47.8 92.2 47.6 35.7.3 72-32.8 92.3-47.6 102-74.1 131.6-96.3 154-113.7zM256 320c23.2.4 56.6-29.2 73.4-41.4 132.7-96.3 142.8-104.7 173.4-128.7 5.8-4.5 9.2-11.5 9.2-18.9v-19c0-26.5-21.5-48-48-48H48C21.5 64 0 85.5 0 112v19c0 7.4 3.4 14.3 9.2 18.9 30.6 23.9 40.7 32.4 173.4 128.7 16.8 12.2 50.2 41.8 73.4 41.4z"></path>
          </svg>
        </div>
        <a href="mailto:undercontrol@financewithflow.com" class="info-link">
          undercontrol@financewithflow.com
        </a>
      </div>

      <div class="info-item">
        <div class="info-icon">
          <svg viewBox="0 0 384 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="28" height="36">
            <path fill="#160F3F" d="M172.268 501.67C26.97 291.031 0 269.413 0 192 0 85.961 85.961 0 192 0s192 85.961 192 192c0 77.413-26.97 99.031-172.268 309.67-9.535 13.774-29.93 13.773-39.464 0zM192 272c44.183 0 80-35.817 80-80s-35.817-80-80-80-80 35.817-80 80 35.817 80 80 80z"></path>
          </svg>
        </div>
        <span class="info-text">
          Based in Colchester
        </span>
      </div>
    </div>
  </section>

  <script is:inline>
    function applyPackageQuery() {
      const params = new URLSearchParams(window.location.search);
      const pkg = params.get('package');
      if (!pkg) return;
      
      const moreAboutInput = document.getElementById('form-field-moreabout');
      const servicesSelect = document.getElementById('form-field-services');
      
      const pkgNames = {
        sunstone: 'Sunstone Package',
        carnelian: 'Carnelian Package',
        agate: 'Agate Package'
      };
      
      const selectedPkgName = pkgNames[pkg.toLowerCase()];
      if (selectedPkgName) {
        if (moreAboutInput && !moreAboutInput.value) {
          moreAboutInput.value = `Enquiring about the ${selectedPkgName}`;
        }
        if (servicesSelect) {
          const matchOpt = Array.from(servicesSelect.options).find(o => o.text.trim() === 'Fully Outsourced Finance Team');
          if (matchOpt) servicesSelect.value = matchOpt.value;
        }
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', applyPackageQuery);
    } else {
      applyPackageQuery();
    }
    document.addEventListener('astro:page-load', applyPackageQuery);
  </script>
</BaseLayout>

<style>
  /* ----------------------------------------------------
     Hero Section
     ---------------------------------------------------- */
  .contact-hero {
    position: relative;
    min-height: 45vh;
    display: flex;
    align-items: center;
    background-image: url('/wp-content/uploads/2023/12/Roz-sat-on-sofa-at-FWF-office-with-cup-of-tea.jpg');
    background-size: cover;
    background-position: right center;
    background-repeat: no-repeat;
    padding: 60px 40px;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(271deg, rgba(101, 126, 187, 0.8) 0%, rgba(22, 15, 63, 0.8) 62%);
    z-index: 1;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    max-width: 1140px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-subtitle {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.5em;
    font-weight: 400;
    color: #FEF9F3;
    margin-bottom: 8px;
    display: block;
  }

  .hero-logo-wrapper {
    margin: 0 0 10px -4px;
    width: 100%;
  }

  .hero-logo {
    width: 35%;
    max-width: 380px;
    min-width: 240px;
    height: auto;
    display: block;
  }

  .hero-tagline {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.5em;
    font-weight: 400;
    color: #FFFFFF;
    margin: 0;
  }

  /* ----------------------------------------------------
     Discovery Call Section
     ---------------------------------------------------- */
  .discovery-section {
    background-color: #FFFFFF;
    padding: 100px 20px;
    text-align: center;
  }

  .discovery-container {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .discovery-text {
    font-family: 'Quicksand', sans-serif;
    font-size: 2.2em;
    font-weight: 500;
    color: #160F3F;
    line-height: 1.4;
    margin: 0 0 40px;
  }

  .discovery-btn {
    display: inline-block;
    background-color: #160F3F;
    color: #FFFFFF;
    font-family: 'Quicksand', sans-serif;
    font-size: 1.1em;
    font-weight: 600;
    padding: 14px 38px;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .discovery-btn:hover {
    background-color: #31CDB0;
    color: #160F3F;
  }

  /* ----------------------------------------------------
     Event Promo Section
     ---------------------------------------------------- */
  .event-section {
    background-color: #FFFFFF;
    padding: 50px 20px 40px;
    border-top: 1px solid #E8EBF2;
    border-bottom: 1px solid #E8EBF2;
  }

  .event-container {
    max-width: 1140px;
    margin: 0 auto;
  }

  /* ----------------------------------------------------
     Form Section
     ---------------------------------------------------- */
  .form-section {
    background-color: #FEF9F3;
    padding: 100px 20px;
  }

  .form-container {
    max-width: 820px;
    margin: 0 auto;
  }

  .form-intro {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.2em;
    font-weight: 500;
    color: #160F3F;
    text-align: center;
    margin: 0 auto 50px;
    line-height: 1.5;
  }

  .form-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .col-half {
    width: calc(50% - 6px);
  }

  .col-full {
    width: 100%;
  }

  .form-label {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.05em;
    font-weight: 600;
    color: #160F3F;
    margin-bottom: 8px;
  }

  .form-input,
  .form-select {
    width: 100%;
    padding: 14px 18px;
    font-family: 'Quicksand', sans-serif;
    font-size: 1.05em;
    color: #160F3F;
    background-color: #FFFFFF;
    border: 1px solid transparent;
    border-radius: 6px;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    box-sizing: border-box;
  }

  .form-input::placeholder {
    color: #8C8C8C;
  }

  .form-input:focus,
  .form-select:focus {
    border-color: #31CDB0;
    box-shadow: 0 0 0 2px rgba(49, 205, 176, 0.2);
  }

  .select-wrapper {
    position: relative;
    width: 100%;
  }

  .form-select {
    appearance: none;
    -webkit-appearance: none;
    padding-right: 42px;
    cursor: pointer;
    background-image: url("data:image/svg+xml,%3Csvg fill='%23160F3F' height='24' viewBox='0 0 24 24' width='24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M7 10l5 5 5-5z'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 14px center;
  }

  .checkbox-group {
    margin-top: 10px;
    margin-bottom: 10px;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-family: 'Quicksand', sans-serif;
    font-size: 0.95em;
    color: #160F3F;
    line-height: 1.5;
    cursor: pointer;
  }

  .form-checkbox {
    width: 18px;
    height: 18px;
    accent-color: #31CDB0;
    margin-top: 3px;
    flex-shrink: 0;
    cursor: pointer;
  }

  .submit-group {
    margin-top: 10px;
  }

  .submit-btn {
    width: 100%;
    background-color: #31CDB0;
    color: #FFFFFF;
    font-family: 'Quicksand', sans-serif;
    font-size: 1.2em;
    font-weight: 600;
    padding: 16px 24px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .submit-btn:hover {
    background-color: #3456A7;
    color: #FFFFFF;
  }

  /* ----------------------------------------------------
     Bottom Info Section
     ---------------------------------------------------- */
  .info-section {
    background-color: #FFFFFF;
    padding: 60px 20px;
  }

  .info-container {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    gap: 40px;
  }

  .info-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }

  .info-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .info-link,
  .info-text {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.4em;
    font-weight: 500;
    color: #160F3F;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .info-link:hover {
    color: #31CDB0;
  }

  /* ----------------------------------------------------
     Responsive Breakpoints
     ---------------------------------------------------- */
  @media (max-width: 768px) {
    .contact-hero {
      min-height: 60vh;
      padding: 40px 20px;
      background-position: center center;
    }

    .hero-logo {
      width: 80%;
    }

    .discovery-section {
      padding: 60px 20px;
    }

    .discovery-text {
      font-size: 1.6em;
    }

    .form-section {
      padding: 60px 20px;
    }

    .col-half {
      width: 100%;
    }

    .info-container {
      flex-direction: column;
      gap: 30px;
    }

    .info-link,
    .info-text {
      font-size: 1.2em;
    }
  }
</style>
